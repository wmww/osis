#!/usr/bin/env python3
"""Run a command that uses every core under the box-wide heavy lock, logging what it cost.

  tools/heavy [--limit NAME] [--log FILE] CMD [ARGS...]   wait for the lock, run CMD, release; exits with CMD's code
  tools/heavy --report [--since HOURS]   the lock's use and the box's CPU from the log
  tools/heavy --record BIN [ARGS...]   internal: cargo's runner while a cargo test/run builds

One all-core run at a time per box (notes/build.md): the gate's tests (one hold per gate),
release checks, by-hand property and sim runs, TLC and roles-model runs. Builds and single-crate
test runs stay unlocked. The lock is ${XDG_RUNTIME_DIR:-/tmp}/osis-gate.lock (flock(2), the same lock as
flock(1)); the command inherits it, so it stays held while the command runs even if this wrapper
dies. The command sees HEAVY_HELD=1; a tools/heavy inside it refuses (it would wait on itself).
--log FILE sends the command's stdout and stderr to FILE, making its directory first: a shell
redirect into a missing directory fails before tools/heavy starts, so nothing runs (exit 1).

A `cargo test` or `cargo run` (maybe after `env VAR=VAL...`) builds before queueing, with
tools/heavy as cargo's runner (`--record`): cargo compiles and chooses each binary, its args, cwd
and env as usual, and each is copied to a private dir instead of run. The hold then runs the
copies in order, with cargo's `Running` lines, stopping at a failing test binary unless
--no-fail-fast (exit 101, as cargo). So the hold runs what was on disk at invocation and compiles
nothing; a build failure exits with cargo's code without queueing. Not covered: doctests (cargo
runs them itself, while building, unlocked; most crates set doctest = false), files and binaries a
test reads from the tree at run time, and cargo inside a script or another program.

Log: ~/.cache/osis/heavy.log, one JSON object per line. Every line carries the box's cumulative
CPU jiffies (`busy`, `all` from /proc/stat), so any two lines give the box's utilization between
them. Events: `acq` (lock taken: who, cmd, wait, and the box at the request), `smp` (every
SAMPLE_S while held), `rel` (released: held, the command's CPU-s from its rusage, exit code).
tools/agent-times.py charges each acquisition to the agent whose command ran it.

Time limits (notes/build.md): the hold's CPU-s and wall are checked against NAME's limits
(default `heavy`, a hold's own; the gate's is `gate.hold`) by tools/limits.py, which prints an
over-limit line and logs the hit. The wait is not part of the hold: with HEAVY_WAIT_FILE set, its
seconds are written there (the gate's own limit leaves them out).
"""
import errno, fcntl, json, os, re, resource, shlex, shutil, signal, subprocess, sys, tempfile, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import limits  # noqa: E402

LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "osis-gate.lock")
LOG = os.path.expanduser("~/.cache/osis/heavy.log")
# Minor consequence: past it the log moves to heavy.log.1 (one generation kept), so at most twice
# this on disk; 0 would keep only the last line, infinity grows without bound. About 200 bytes a
# line, 6 samples a minute held: weeks of normal use.
LOG_CAP = 8 << 20
# Minor consequence: the time resolution of utilization while held. 0 spins, infinity leaves
# only the acq-to-rel average.
SAMPLE_S = 10


def stat():
    """The box's cumulative (busy, all) CPU jiffies over every core."""
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:9]]
    idle = v[3] + v[4]  # idle + iowait
    return sum(v) - idle, sum(v)


def log(ev, **kw):
    b, a = stat()
    line = json.dumps(dict(ev=ev, t=round(time.time(), 2), pid=os.getpid(), busy=b, all=a, **kw), separators=(",", ":"))
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_CAP:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write(line + "\n")  # one write of under 4 KB to an O_APPEND file: lines never interleave
    except OSError as e:
        print(f"heavy: log: {e}", file=sys.stderr)


def git(*a):
    r = subprocess.run(["git", *a], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def via():
    """What started us: the parent's script (gate.sh) or program."""
    try:
        argv = open(f"/proc/{os.getppid()}/cmdline", "rb").read().decode(errors="replace").split("\0")
    except OSError:
        return ""
    for a in argv[1:]:
        if a.endswith((".sh", ".py")):
            return os.path.basename(a)
    return os.path.basename(argv[0])


def cargo_sub(cmd):
    """`test` or `run` when cmd is a cargo test or run, maybe after `env VAR=VAL...`; else None."""
    i = 0
    if os.path.basename(cmd[0]) == "env":
        i = 1
        while i < len(cmd) and "=" in cmd[i] and not cmd[i].startswith("-"):
            i += 1
    if i >= len(cmd) or os.path.basename(cmd[i]) != "cargo":
        return None
    for a in cmd[i + 1:]:
        if not a.startswith(("-", "+")):
            return {"test": "test", "t": "test", "run": "run", "r": "run"}.get(a)
    return None


def runner_var():
    host = next(l.split()[1] for l in subprocess.run(["rustc", "-vV"], capture_output=True, text=True, check=True).stdout.splitlines()
                if l.startswith("host:"))
    return "CARGO_TARGET_" + re.sub(r"[^A-Z0-9]", "_", host.upper()) + "_RUNNER"


def record(argv):
    """Cargo's runner while building (`--record BIN ARGS...`): copy BIN, note its args, cwd and env, run nothing."""
    rec, var = os.environ["HEAVY_RECORD"], os.environ["HEAVY_RUNNER_VAR"]
    n = 0
    while True:
        try:
            fd = os.open(os.path.join(rec, f"{n:04d}.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            break
        except FileExistsError:
            n += 1
    copy = os.path.join(rec, f"{n:04d}-{os.path.basename(argv[0])}")
    shutil.copy2(argv[0], copy)
    env = {k: v for k, v in os.environ.items() if k not in ("HEAVY_RECORD", "HEAVY_RUNNER_VAR", var)}
    with os.fdopen(fd, "w") as f:
        json.dump(dict(bin=argv[0], argv=[copy, *argv[1:]], cwd=os.getcwd(), env=env), f)


def build(cmd, rec, out):
    """Run the cargo command with tools/heavy as its runner: cargo builds and picks the binaries,
    args, cwd and env as usual, and each run is recorded (`record`) with a copy of its binary.
    Returns cargo's exit code and the runs, each with cargo's `Running` line for it."""
    var = runner_var()
    env = dict(os.environ, HEAVY_RECORD=rec, HEAVY_RUNNER_VAR=var)
    env[var] = os.path.realpath(__file__) + " --record"
    sink = out or sys.stderr
    lines = {}
    p = subprocess.Popen(cmd, env=env, stdout=out, stderr=subprocess.PIPE, text=True, errors="replace")
    for line in p.stderr:
        if line.lstrip().startswith("Running "):  # printed again when the copy runs
            m = re.search(r"\((\S+)\)$", line.rstrip())
            if m:
                lines[os.path.basename(m.group(1))] = line
        else:
            sink.write(line)
            sink.flush()
    rc = p.wait()
    runs = []
    for f in sorted(x for x in os.listdir(rec) if x.endswith(".json")):
        with open(os.path.join(rec, f)) as fh:
            r = json.load(fh)
        r["line"] = lines.get(os.path.basename(r["bin"]), f"     Running {r['bin']}\n")
        runs.append(r)
    return rc, runs


def run(cmd, name, out=None):
    # the lock is per open file: a hold inside a hold would wait on itself forever
    if os.environ.get("HEAVY_HELD"):
        sys.exit("heavy: already inside a hold (HEAVY_HELD): run the command directly")
    top = git("rev-parse", "--show-toplevel") or os.getcwd()
    who = dict(who=top, branch=git("rev-parse", "--abbrev-ref", "HEAD"), sess=os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
               via=via(), cmd=shlex.join(cmd)[:500])
    if out:
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        out = open(out, "w")
    sub = cargo_sub(cmd)
    if not sub:
        return hold(cmd, name, out, who, [dict(argv=cmd, cwd=None, env=None)], sub)
    rec = tempfile.mkdtemp(prefix="osis-heavy-")
    try:
        rc, runs = build(cmd, rec, out)
        if rc or not runs:
            return rc
        print(f"heavy: built; the hold runs copies of {len(runs)} binaries: later edits don't reach them", file=sys.stderr)
        return hold(cmd, name, out, who, runs, sub)
    finally:
        shutil.rmtree(rec, ignore_errors=True)


def hold(cmd, name, out, who, runs, sub):
    """Take the lock and run each of runs in order. A cargo test stops at the first failing binary
    unless --no-fail-fast, and exits 101 when any failed, as cargo does."""
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    t0, (b0, a0) = time.time(), stat()
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"heavy: waiting for {LOCK} (another all-core run)", file=sys.stderr)
        fcntl.flock(fd, fcntl.LOCK_EX)
    t1 = time.time()
    log("acq", wait=round(t1 - t0, 1), busy0=b0, all0=a0, **who)
    if t1 - t0 >= 1:
        print(f"heavy: waited {t1 - t0:.0f} s for the lock", file=sys.stderr)
    if os.environ.get("HEAVY_WAIT_FILE"):
        try:
            with open(os.environ["HEAVY_WAIT_FILE"], "w") as f:
                f.write(f"{t1 - t0:.0f}\n")
        except OSError as e:
            print(f"heavy: {e}", file=sys.stderr)
    ru0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    cur = [None]
    # forward the usual stop signals; the child shares our process group, so a group kill reaches it anyway
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda n, _f: cur[0] and cur[0].send_signal(n))
    keep_going = "--no-fail-fast" in cmd[:cmd.index("--")] if "--" in cmd else "--no-fail-fast" in cmd
    rc, failed = 0, False
    for r in runs:
        if r.get("line"):
            (out or sys.stderr).write(r["line"])
            (out or sys.stderr).flush()
        env = dict(r["env"] or os.environ, HEAVY_HELD="1")
        try:
            try:
                p = subprocess.Popen(r["argv"], cwd=r["cwd"], pass_fds=(fd,), env=env, stdout=out, stderr=out)
            except OSError as e:
                if e.errno != errno.ENOEXEC:
                    raise
                p = subprocess.Popen(["sh", *r["argv"]], cwd=r["cwd"], pass_fds=(fd,), env=env, stdout=out, stderr=out)  # a script without a #! line, as a shell runs it
        except OSError as e:
            log("rel", held=round(time.time() - t1, 1), cpu=0, rc=127)
            sys.exit(f"heavy: {r['argv'][0]}: {e}")
        cur[0] = p
        while True:
            try:
                rc = p.wait(SAMPLE_S)
                break
            except subprocess.TimeoutExpired:
                log("smp")
        rc = 128 - rc if rc < 0 else rc
        if rc:
            failed = True
            if sub == "test":
                print(f"heavy: {r['bin']} failed (exit {rc})", file=out or sys.stderr)
            if not keep_going:
                break
    if sub == "test":
        rc = 101 if failed else 0
    ru = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu = ru.ru_utime + ru.ru_stime - ru0.ru_utime - ru0.ru_stime
    held = time.time() - t1
    log("rel", held=round(held, 1), cpu=round(cpu, 1), rc=rc)
    limits.safe_check(name, cpu, held)
    return rc


def report(hours):
    ev = limits.jsonl((LOG + ".1", LOG), time.time() - hours * 3600 if hours else 0)
    if not ev:
        sys.exit(f"no events in {LOG}")
    ncpu = os.cpu_count()

    def util(b0, a0, b1, a1):
        return (b1 - b0) / (a1 - a0) if a1 > a0 and b1 >= b0 else None

    def pct(u):
        return f"{100 * u:3.0f}%" if u is not None else "   ?"

    acq, runs = {}, []
    for o in ev:
        if o["ev"] == "acq":
            acq[o["pid"]] = dict(o, smp=[])
        elif o["ev"] == "smp" and o["pid"] in acq:
            acq[o["pid"]]["smp"].append(o)
        elif o["ev"] == "rel" and o["pid"] in acq:
            a = acq.pop(o["pid"])
            runs.append((a, o))
    print(f"{len(runs)} locked runs ({len(acq)} unfinished or killed). wait/held in minutes; own = the run's CPU-s over held x "
          f"{ncpu} cores; box = every process's CPU while held; waitbox = the box while it waited; min = lowest {SAMPLE_S} s sample")
    print(f"{'start':11s} {'wait':>5s} {'held':>5s} {'CPU-s':>7s} {'own':>4s} {'box':>4s} {'min':>4s} {'waitbox':>7s} {'rc':>3s}  who: command")
    for a, r in runs:
        pts = [a] + a["smp"] + [r]
        mins = [util(x["busy"], x["all"], y["busy"], y["all"]) for x, y in zip(pts, pts[1:])]
        mins = [m for m in mins if m is not None]
        own = r["cpu"] / (r["held"] * ncpu) if r["held"] else None
        print(f"{time.strftime('%d %H:%M:%S', time.localtime(a['t'])):11s} {a['wait']/60:5.1f} {r['held']/60:5.1f} {r['cpu']:7.0f} "
              f"{pct(own)} {pct(util(a['busy'], a['all'], r['busy'], r['all']))} {pct(min(mins) if len(mins) > 1 else None)} "
              f"{pct(util(a['busy0'], a['all0'], a['busy'], a['all'])):>7s} {r['rc']:3d}  "
              f"{os.path.basename(a['who'])} {a['branch']}{' ' + a['via'] if a['via'] else ''}: {a['cmd'][:70]}")
    # the box over the whole span, split by whether the lock was held (a reboot resets the counters: skipped)
    pts = sorted(ev, key=lambda o: o["t"])
    held_until, sums = {}, {"held": [0, 0], "free": [0, 0]}
    for x, y in zip(pts, pts[1:]):
        if x["ev"] == "acq":
            held_until[x["pid"]] = True
        if x["ev"] == "rel":
            held_until.pop(x["pid"], None)
        if y["all"] > x["all"] and y["busy"] >= x["busy"]:
            s = sums["held" if held_until else "free"]
            s[0] += y["busy"] - x["busy"]
            s[1] += y["all"] - x["all"]
    hz = os.sysconf("SC_CLK_TCK") * ncpu
    print("\nbox CPU between log events: " + ", ".join(
        f"lock {k} {s[1] / hz / 60:.0f} min at {pct(s[0] / s[1])}" for k, s in sums.items() if s[1]))
    w = sum(a["wait"] for a, _ in runs)
    h = sum(r["held"] for _, r in runs)
    print(f"totals: waited {w/60:.0f} min, held {h/60:.0f} min, {sum(r['cpu'] for _, r in runs):.0f} CPU-s locked")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--record"]:
        sys.exit(record(a[1:]))
    if a[:1] == ["--report"]:
        report(float(a[2]) if a[1:2] == ["--since"] and len(a) > 2 else 0)
        sys.exit()
    opts = {"--limit": "heavy", "--log": None}
    while a[:1] and a[0] in opts and len(a) > 2:
        opts[a[0]] = a[1]
        a = a[2:]
    if not a or a[0].startswith("-"):
        sys.exit(__doc__)
    sys.exit(run(a, opts["--limit"], opts["--log"]))
