#!/usr/bin/env python3
"""Run a command that uses every core under the box-wide heavy lock, logging what it cost.

  tools/heavy [--limit NAME] [--log FILE] CMD [ARGS...]   wait for the lock, run CMD, release; exits with CMD's code
  tools/heavy --short [--log FILE] CMD [ARGS...]   run CMD in the short lane, beside any hold; stopped past its caps
  tools/heavy --report [--since HOURS]   the lock's use and the box's CPU from the log
  tools/heavy --record BIN [ARGS...]   internal: cargo's runner while a cargo test/run builds

One all-core run at a time per box (notes/build.md): the gate's tests (one hold per gate),
release checks, by-hand property and sim runs, TLC and roles-model runs. Builds and single-crate
test runs stay unlocked. The lock is ${XDG_RUNTIME_DIR:-/tmp}/osis-gate.lock (flock(2), the same lock as
flock(1)); the command inherits it, so it stays held while the command runs even if this wrapper
dies. The command sees HEAVY_HELD=1; a tools/heavy inside it refuses (it would wait on itself).
--log FILE sends the command's stdout and stderr to FILE, making its directory first: a shell
redirect into a missing directory fails before tools/heavy starts, so nothing runs (exit 1). A
wait for the lock is written there too (since when, then how long), so the file is never silently
empty while it queues.

A `cargo test` or `cargo run` (maybe after `env VAR=VAL...`) builds before queueing, with
tools/heavy as cargo's runner (`--record`): cargo compiles and chooses each binary, its args, cwd
and env as usual, and each is copied to a private dir instead of run. The hold then runs the
copies in order, with cargo's `Running` lines, stopping at a failing test binary unless
--no-fail-fast (exit 101, as cargo). So the hold runs what was on disk at invocation and compiles
nothing; a build failure exits with cargo's code without queueing. Not covered: doctests (cargo
runs them itself, while building, unlocked; most crates set doctest = false), files and binaries a
test reads from the tree at run time, and cargo inside a script or another program.

Log: ~/.cache/osis/heavy.log, one JSON object per line. Every line carries the box's cumulative
CPU jiffies (`busy`, `all` from /proc/stat), so any two lines give the box's utilization between
them. Events: `acq` (lock taken: who, cmd, wait, and the box at the request), `smp` (every
SAMPLE_S while held: the run's CPU-s so far), `yld` (a quiet hold released the lock, run going on),
`back` (a yielded run holds it again: wait, paused), `rel` (the command ended: held, its wall from
the first acquisition, the command's CPU-s from its rusage, exit code).
tools/agent-times.py charges each acquisition to the agent whose command ran it.

The short lane (--short): a run small enough to cost a hold beside it little needs no wait for one.
It takes only the lane's own lock (one short run at a time, so the lane adds at most one all-core run
beside a hold) and is stopped, its whole process tree killed (exit 137), once its CPU-s or wall pass
limit `heavy.short` or its processes' resident memory passes SHORT_RSS. The run's CPU-s counts every
process it started, finished or running; for a cargo test, only the copies' run (the build is
unlocked anyway). Never for a command that edits the tree (tools/mutate.py): a stop leaves its edit
in place. Every hold prints whether it would have fit the lane. A stop prints the CPU-s used and the
plain tools/heavy command to run instead; a --short of a command whose last logged run was stopped
in the lane or took more CPU-s than its cap in a hold is refused at once (exit 2, the same line),
before any build: the run it would repeat is the one that queues for a hold.

A quiet hold yields (notes/build.md, Heavy lock): the lock keeps all-core runs apart, so a hold
whose process tree has used under YIELD_CORES cores over the last YIELD_WINDOW_S, at most SHORT_RSS
resident, while another run waits for the lock, releases it and runs on beside the next holder
(one yielded run box-wide: its own lock). While yielded it must stay that small: a sample over
YIELD_CORES or SHORT_RSS stops (SIGSTOP) its whole tree until it holds the lock again, then
continues (SIGCONT); its next binary also waits for the lock. Nothing is killed and no work lost;
a holder pays at most YIELD_CORES / cores of its wall for it.

Time limits (notes/build.md): the hold's CPU-s and wall are checked against NAME's limits
(default `heavy`, a hold's own; the gate's is `gate.hold`) by tools/limits.py, which prints an
over-limit line and logs the hit. The wait is not part of the hold: with HEAVY_WAIT_FILE set, its
seconds are written there (the gate's own limit leaves them out).
"""
import errno, fcntl, json, os, re, resource, shlex, shutil, signal, subprocess, sys, tempfile, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import limits  # noqa: E402

LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "osis-gate.lock")
SHORT_LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "osis-short.lock")
YIELD_LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "osis-yield.lock")
# The short lane's memory cap (its CPU and wall caps are limit `heavy.short`): the summed resident
# memory of the run's processes. The heavy lock's other job is keeping two large runs out of one
# 30 GB box; 0 would stop every run, infinity would let a 16 GB bench beside a gate push the box into
# swap. 4 GB is 20-100x a roles-model search or a held-model run and leaves a gate its room.
SHORT_RSS = 4 << 30
# How often the lane measures its run: a run can pass a cap by this long's work (16 threads x 1 s);
# 0 spins, infinity never stops anything.
SHORT_POLL_S = 1
LOG = os.path.expanduser("~/.cache/osis/heavy.log")
# Minor consequence: past it the log moves to heavy.log.1 (one generation kept), so at most twice
# this on disk; 0 would keep only the last line, infinity grows without bound. About 200 bytes a
# line, 6 samples a minute held: weeks of normal use.
LOG_CAP = 8 << 20
# Minor consequence: the time resolution of utilization while held. 0 spins, infinity leaves
# only the acq-to-rel average.
SAMPLE_S = 10
# A quiet hold yields (module doc). YIELD_CORES: the cores a run may use beside a holder, costing it
# up to this / 16 of its wall; 0 never yields (a sleeping run holds the lock as today), infinity
# yields every hold with a waiter and lets all-core runs overlap. 1.5 is over a single-threaded run
# (100-106% of a core) and under any run worth the lock. YIELD_WINDOW_S: how long a hold must stay
# quiet; 0 yields an all-core run at a pause between its phases, infinity never yields. 300 s is
# past the gate's quiet spans (a binary's slow tail, about a minute; a sim storm seed, 2-3 min on one
# core; a hung test is stopped at 150 s) and is the most a waiter loses to a one-core hold.
YIELD_CORES = 1.5
YIELD_WINDOW_S = 300


def stat():
    """The box's cumulative (busy, all) CPU jiffies over every core."""
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:9]]
    idle = v[3] + v[4]  # idle + iowait
    return sum(v) - idle, sum(v)


def log(ev, **kw):
    b, a = stat()
    line = json.dumps(dict(ev=ev, t=round(time.time(), 2), pid=os.getpid(), busy=b, all=a, **kw), separators=(",", ":"))
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_CAP:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write(line + "\n")  # one write of under 4 KB to an O_APPEND file: lines never interleave
    except OSError as e:
        print(f"heavy: log: {e}", file=sys.stderr)


def git(*a):
    r = subprocess.run(["git", *a], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def via():
    """What started us: the parent's script (gate.sh) or program."""
    try:
        argv = open(f"/proc/{os.getppid()}/cmdline", "rb").read().decode(errors="replace").split("\0")
    except OSError:
        return ""
    for a in argv[1:]:
        if a.endswith((".sh", ".py")):
            return os.path.basename(a)
    return os.path.basename(argv[0])


def cargo_sub(cmd):
    """`test` or `run` when cmd is a cargo test or run, maybe after `env VAR=VAL...`; else None."""
    i = 0
    if os.path.basename(cmd[0]) == "env":
        i = 1
        while i < len(cmd) and "=" in cmd[i] and not cmd[i].startswith("-"):
            i += 1
    if i >= len(cmd) or os.path.basename(cmd[i]) != "cargo":
        return None
    for a in cmd[i + 1:]:
        if not a.startswith(("-", "+")):
            return {"test": "test", "t": "test", "run": "run", "r": "run"}.get(a)
    return None


def runner_var():
    host = next(l.split()[1] for l in subprocess.run(["rustc", "-vV"], capture_output=True, text=True, check=True).stdout.splitlines()
                if l.startswith("host:"))
    return "CARGO_TARGET_" + re.sub(r"[^A-Z0-9]", "_", host.upper()) + "_RUNNER"


def record(argv):
    """Cargo's runner while building (`--record BIN ARGS...`): copy BIN, note its args, cwd and env, run nothing."""
    rec, var = os.environ["HEAVY_RECORD"], os.environ["HEAVY_RUNNER_VAR"]
    n = 0
    while True:
        try:
            fd = os.open(os.path.join(rec, f"{n:04d}.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            break
        except FileExistsError:
            n += 1
    copy = os.path.join(rec, f"{n:04d}-{os.path.basename(argv[0])}")
    shutil.copy2(argv[0], copy)
    env = {k: v for k, v in os.environ.items() if k not in ("HEAVY_RECORD", "HEAVY_RUNNER_VAR", var)}
    with os.fdopen(fd, "w") as f:
        json.dump(dict(bin=argv[0], argv=[copy, *argv[1:]], cwd=os.getcwd(), env=env), f)


def build(cmd, rec, out):
    """Run the cargo command with tools/heavy as its runner: cargo builds and picks the binaries,
    args, cwd and env as usual, and each run is recorded (`record`) with a copy of its binary.
    Returns cargo's exit code and the runs, each with cargo's `Running` line for it."""
    var = runner_var()
    env = dict(os.environ, HEAVY_RECORD=rec, HEAVY_RUNNER_VAR=var)
    env[var] = os.path.realpath(__file__) + " --record"
    sink = out or sys.stderr
    lines = {}
    p = subprocess.Popen(cmd, env=env, stdout=out, stderr=subprocess.PIPE, text=True, errors="replace")
    for line in p.stderr:
        if line.lstrip().startswith("Running "):  # printed again when the copy runs
            m = re.search(r"\((\S+)\)$", line.rstrip())
            if m:
                lines[os.path.basename(m.group(1))] = line
        else:
            sink.write(line)
            sink.flush()
    rc = p.wait()
    runs = []
    for f in sorted(x for x in os.listdir(rec) if x.endswith(".json")):
        with open(os.path.join(rec, f)) as fh:
            r = json.load(fh)
        r["line"] = lines.get(os.path.basename(r["bin"]), f"     Running {r['bin']}\n")
        runs.append(r)
    return rc, runs


def proc_table():
    """{pid: (ppid, cpu_s, rss_bytes)} for every process; cpu_s counts its reaped children."""
    tick, page, t = os.sysconf("SC_CLK_TCK"), os.sysconf("SC_PAGE_SIZE"), {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                v = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue  # exited meanwhile
        t[int(d)] = (int(v[1]), sum(int(x) for x in v[11:15]) / tick, int(v[21]) * page)
    return t


def tree(root):
    """The pids of root and its living descendants, with their summed CPU-s and resident memory."""
    t = proc_table()
    kids = {}
    for pid, (pp, _, _) in t.items():
        kids.setdefault(pp, []).append(pid)
    pids, todo = [], [root] if root in t else []
    while todo:
        p = todo.pop()
        pids.append(p)
        todo += kids.get(p, [])
    return pids, sum(t[p][1] for p in pids), sum(t[p][2] for p in pids)


def kill_tree(root):
    """SIGKILL root's tree; a second walk catches what forked during the first."""
    signal_tree(root, signal.SIGKILL)


def signal_tree(root, sig):
    for _ in range(2):
        for p in tree(root)[0]:
            try:
                os.kill(p, sig)
            except OSError:
                pass


def waiters(fd):
    """How many requests wait for the flock on fd's file (/proc/locks lists blocked ones with `->`)."""
    st = os.fstat(fd)
    key = f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"
    try:
        with open("/proc/locks") as f:
            return sum(1 for l in f if "->" in l.split()[:2] and l.split()[-3] == key)
    except OSError:
        return 0


def quiet(samples):
    """samples: (time, CPU-s) of the run, oldest first. Whether it used under YIELD_CORES over the
    last YIELD_WINDOW_S (False until it has run that long)."""
    t, c = samples[-1]
    old = [s for s in samples if t - s[0] >= YIELD_WINDOW_S]
    return bool(old) and c - old[-1][1] < YIELD_CORES * (t - old[-1][0])


def run(cmd, name, out=None, short=False):
    # the lock is per open file: a hold inside a hold would wait on itself forever
    if os.environ.get("HEAVY_HELD"):
        sys.exit("heavy: already inside a hold (HEAVY_HELD): run the command directly")
    top = git("rev-parse", "--show-toplevel") or os.getcwd()
    who = dict(who=top, branch=git("rev-parse", "--abbrev-ref", "HEAD"), sess=os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
               via=via(), cmd=shlex.join(cmd)[:500])
    if out:
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        out = open(out, "w")
    lane = None
    if short:
        lane, why = limits.limit("heavy.short")
        if lane is None:
            sys.exit(f"heavy: --short: {why}; run it without --short")
        past = past_cost(who["cmd"], lane)
        if past:
            print(f"heavy: --short refused: this command {past}, past the lane's {lane[0]:.0f} CPU-s; run it in a hold:\n"
                  f"  {plain(cmd, out)}", file=sys.stderr)
            return 2
    sub = cargo_sub(cmd)
    refused = sub and refusal(cmd, top)
    if refused:
        sys.exit(f"heavy: {refused}")
    if not sub:
        return hold(cmd, name, out, who, [dict(argv=cmd, cwd=None, env=None)], sub, lane)
    rec = tempfile.mkdtemp(prefix="osis-heavy-")
    try:
        rc, runs = build(cmd, rec, out)
        if rc or not runs:
            return rc
        print(f"heavy: built; the hold runs copies of {len(runs)} binaries: later edits don't reach them", file=sys.stderr)
        return hold(cmd, name, out, who, runs, sub, lane)
    finally:
        shutil.rmtree(rec, ignore_errors=True)


def refusal(cmd, top):
    """Why a cargo test/run cmd must not run here, or None: a release build (a second artifact set,
    minutes of thin LTO: never inside a task, notes/build.md; the coordinator's benches set
    HEAVY_RELEASE=1), or a build in the main checkout (top: the git toplevel; task worktrees only)."""
    args = cmd[:cmd.index("--")] if "--" in cmd else cmd
    if ("--release" in args or "-r" in args or any(a.startswith("--profile") for a in args)) and not os.environ.get("HEAVY_RELEASE"):
        return "a release or other-profile build: the dev profile only inside a task (notes/build.md, Profile and command forms; HEAVY_RELEASE=1 for the coordinator's benches)"
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common and os.path.dirname(common) == top:
        return f"{top} is the main checkout: build in your task worktree (`wt claim`)"
    return None


def plain(cmd, out):
    """The tools/heavy command that runs cmd in a hold, as the short lane's caller gave it."""
    return shlex.join(["tools/heavy", *(["--log", out.name] if out else []), *cmd])


def past_cost(cmd, lane):
    """How the log's last run of cmd (as `acq` records it) went past the lane's CPU cap: stopped in
    the lane, or over its CPU-s in a hold; None if it fit or never ran. So a command the lane
    stopped once is sent to a hold at once, not built and stopped again."""
    last = None
    acq = {}
    for o in limits.jsonl((LOG + ".1", LOG)):
        if o["ev"] == "acq":
            acq[o["pid"]] = o
        elif o["ev"] == "rel" and acq.get(o["pid"], {}).get("cmd") == cmd:
            last = o
            acq.pop(o["pid"])
    if last is None:
        return None
    if last.get("stop"):
        return f"was stopped in the lane ({last['stop']}, after {last['cpu']:.0f} CPU-s)"
    if last["cpu"] > lane[0]:
        return f"last took {last['cpu']:.0f} CPU-s in a hold"
    return None


def note(out, msg):
    """msg in --log's file when there is one, then on stderr (a reader of stderr finds it in the file)."""
    if out:
        print(msg, file=out, flush=True)
    print(msg, file=sys.stderr, flush=True)


def hold(cmd, name, out, who, runs, sub, lane=None):
    """Take the lock (with lane, the short lane's: its (CPU-s, wall) caps) and run each of runs in
    order. A cargo test stops at the first failing binary unless --no-fail-fast, and exits 101 when
    any failed, as cargo does."""
    path = SHORT_LOCK if lane else LOCK
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o666)
    t0, (b0, a0) = time.time(), stat()
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # to --log's file too: a log empty for minutes otherwise reads as a hung run
        note(out, f"heavy: waiting for {path} ({'another short run' if lane else 'another all-core run'}) since {time.strftime('%H:%M:%S')}")
        fcntl.flock(fd, fcntl.LOCK_EX)
    t1 = time.time()
    log("acq", wait=round(t1 - t0, 1), busy0=b0, all0=a0, **(dict(lane="short") if lane else {}), **who)
    if t1 - t0 >= 1:
        note(out, f"heavy: waited {t1 - t0:.0f} s for the lock")
    if os.environ.get("HEAVY_WAIT_FILE"):
        try:
            with open(os.environ["HEAVY_WAIT_FILE"], "w") as f:
                f.write(f"{t1 - t0:.0f}\n")
        except OSError as e:
            print(f"heavy: {e}", file=sys.stderr)
    ru0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    cur = [None]
    # forward the usual stop signals; the child shares our process group, so a group kill reaches it anyway
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda n, _f: cur[0] and cur[0].send_signal(n))
    keep_going = "--no-fail-fast" in cmd[:cmd.index("--")] if "--" in cmd else "--no-fail-fast" in cmd
    rc, failed, stop = 0, False, None
    yfd = None  # while yielded: the yield lock, held

    def say(msg):
        print(f"heavy: {msg}", file=sys.stderr)
        if out:
            print(f"heavy: {msg}", file=out, flush=True)

    def retake(pid=None):
        """A yielded run takes the lock again; pid: its running tree, stopped while it waits."""
        nonlocal yfd
        if pid:
            signal_tree(pid, signal.SIGSTOP)
            say("the yielded run went over its share beside the hold: stopped until it holds the lock again")
        tw = time.time()
        fcntl.flock(fd, fcntl.LOCK_EX)
        log("back", wait=round(time.time() - tw, 1), paused=bool(pid))
        if pid:
            signal_tree(pid, signal.SIGCONT)
            say(f"holds the lock again after {time.time() - tw:.0f} s: continued")
        os.close(yfd)
        yfd = None

    def used():
        ru = resource.getrusage(resource.RUSAGE_CHILDREN)
        _, live, rss = tree(p.pid)
        return ru.ru_utime + ru.ru_stime - ru0.ru_utime - ru0.ru_stime + live, rss

    for r in runs:
        if yfd is not None:
            retake()
        if r.get("line"):
            (out or sys.stderr).write(r["line"])
            (out or sys.stderr).flush()
        env = dict(r["env"] or os.environ, HEAVY_HELD="1")
        try:
            try:
                p = subprocess.Popen(r["argv"], cwd=r["cwd"], pass_fds=(fd,), env=env, stdout=out, stderr=out)
            except OSError as e:
                if e.errno != errno.ENOEXEC:
                    raise
                p = subprocess.Popen(["sh", *r["argv"]], cwd=r["cwd"], pass_fds=(fd,), env=env, stdout=out, stderr=out)  # a script without a #! line, as a shell runs it
        except OSError as e:
            log("rel", held=round(time.time() - t1, 1), cpu=0, rc=127)
            sys.exit(f"heavy: {r['argv'][0]}: {e}")
        cur[0] = p
        samples = [(time.time(), used()[0])]
        while True:
            try:
                rc = p.wait(SHORT_POLL_S if lane else SAMPLE_S)
                break
            except subprocess.TimeoutExpired:
                cpu, rss = used()
                if not lane:
                    samples.append((time.time(), cpu))
                    log("smp", cpu=round(cpu, 1))
                    if yfd is None:
                        if quiet(samples) and rss <= SHORT_RSS and waiters(fd):
                            yfd = os.open(YIELD_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
                            try:
                                fcntl.flock(yfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                            except BlockingIOError:  # another run is yielded: keep holding
                                os.close(yfd)
                                yfd = None
                                continue
                            fcntl.flock(fd, fcntl.LOCK_UN)
                            log("yld", cpu=round(cpu, 1))
                            say(f"under {YIELD_CORES} cores for {YIELD_WINDOW_S} s while another run waits: "
                                "lock released, this run goes on beside the next hold")
                    else:
                        (t0s, c0), (t1s, c1) = samples[-2:]
                        if c1 - c0 > YIELD_CORES * (t1s - t0s) or rss > SHORT_RSS:
                            retake(p.pid)
                            samples = [(time.time(), used()[0])]
                    del samples[:-(int(YIELD_WINDOW_S / SAMPLE_S) + 2)]
                    continue
                stop = next((f"{k} {v:.0f} past the lane's {c:.0f}" for k, v, c in (
                    ("CPU-s", cpu, lane[0]), ("wall s", time.time() - t1, lane[1]), ("MB resident", rss / 1e6, SHORT_RSS / 1e6)) if v > c), None)
                if stop:
                    kill_tree(p.pid)
                    p.wait()
                    msg = (f"heavy: --short run stopped, {stop} (limit heavy.short, SHORT_RSS) after {cpu:.0f} CPU-s in "
                           f"{time.time() - t1:.0f} s; run it in a hold (a later --short of it is refused):\n  {plain(cmd, out)}")
                    print(msg, file=out or sys.stderr)
                    if out:
                        print(msg, file=sys.stderr)
                    break
        if stop:
            rc = 137
            break
        rc = 128 - rc if rc < 0 else rc
        if rc:
            failed = True
            if sub == "test":
                print(f"heavy: {r['bin']} failed (exit {rc})", file=out or sys.stderr)
            if not keep_going:
                break
    if yfd is not None:
        os.close(yfd)
    if sub == "test" and not stop:
        rc = 101 if failed else 0
    ru = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu = ru.ru_utime + ru.ru_stime - ru0.ru_utime - ru0.ru_stime
    held = time.time() - t1
    log("rel", held=round(held, 1), cpu=round(cpu, 1), rc=rc, **(dict(stop=stop) if stop else {}))
    if lane:
        return rc
    limits.safe_check(name, cpu, held)
    fits, _ = limits.limit("heavy.short")
    if fits and cpu <= fits[0] and held <= fits[1] and ru.ru_maxrss * 1024 <= SHORT_RSS:
        print(f"heavy: {cpu:.0f} CPU-s in {held:.0f} s: this run fits the short lane (`tools/heavy --short`, "
              f"under {fits[0]:.0f} CPU-s, {fits[1]:.0f} s, {SHORT_RSS >> 30} GB), which waits for no hold", file=sys.stderr)
    return rc


def report(hours):
    ev = limits.jsonl((LOG + ".1", LOG), time.time() - hours * 3600 if hours else 0)
    if not ev:
        sys.exit(f"no events in {LOG}")
    ncpu = os.cpu_count()

    def util(b0, a0, b1, a1):
        return (b1 - b0) / (a1 - a0) if a1 > a0 and b1 >= b0 else None

    def pct(u):
        return f"{100 * u:3.0f}%" if u is not None else "   ?"

    def yielded(a):
        ys = [y for y in a["yld"] if y["ev"] == "yld"]
        if not ys:
            return ""
        stops = sum(1 for y in a["yld"] if y["ev"] == "back" and y.get("paused"))
        return f"  [yielded at {(ys[0]['t'] - a['t']) / 60:.0f} min" + (f", stopped {stops}x" if stops else "") + "]"

    acq, runs = {}, []
    for o in ev:
        if o["ev"] == "acq":
            acq[o["pid"]] = dict(o, smp=[], yld=[])
            if o.get("lane"):
                acq[o["pid"]]["via"] = ("short lane " + o["via"]).strip()
        elif o["ev"] == "smp" and o["pid"] in acq:
            acq[o["pid"]]["smp"].append(o)
        elif o["ev"] in ("yld", "back") and o["pid"] in acq:
            acq[o["pid"]]["yld"].append(o)
        elif o["ev"] == "rel" and o["pid"] in acq:
            a = acq.pop(o["pid"])
            runs.append((a, o))
    print(f"{len(runs)} locked runs, {sum(1 for a, _ in runs if a.get('lane'))} of them in the short lane ({len(acq)} unfinished or killed). wait/held in minutes; own = the run's CPU-s over held x "
          f"{ncpu} cores; box = every process's CPU while held; waitbox = the box while it waited; min = lowest {SAMPLE_S} s sample; [yielded at N min]: released the lock as quiet N minutes in (stopped Kx: stopped K times to retake it)")
    print(f"{'start':11s} {'wait':>5s} {'held':>5s} {'CPU-s':>7s} {'own':>4s} {'box':>4s} {'min':>4s} {'waitbox':>7s} {'rc':>3s}  who: command")
    for a, r in runs:
        pts = [a] + a["smp"] + [r]
        mins = [util(x["busy"], x["all"], y["busy"], y["all"]) for x, y in zip(pts, pts[1:])]
        mins = [m for m in mins if m is not None]
        own = r["cpu"] / (r["held"] * ncpu) if r["held"] else None
        print(f"{time.strftime('%d %H:%M:%S', time.localtime(a['t'])):11s} {a['wait']/60:5.1f} {r['held']/60:5.1f} {r['cpu']:7.0f} "
              f"{pct(own)} {pct(util(a['busy'], a['all'], r['busy'], r['all']))} {pct(min(mins) if len(mins) > 1 else None)} "
              f"{pct(util(a['busy0'], a['all0'], a['busy'], a['all'])):>7s} {r['rc']:3d}  "
              f"{os.path.basename(a['who'])} {a['branch']}{' ' + a['via'] if a['via'] else ''}: {a['cmd'][:70]}" + yielded(a))
    # the box over the whole span, split by whether the lock was held (a reboot resets the counters: skipped)
    pts = sorted(ev, key=lambda o: o["t"])
    held_until, sums = {}, {"held": [0, 0], "free": [0, 0]}
    for x, y in zip(pts, pts[1:]):
        if x["ev"] in ("acq", "back") and not x.get("lane"):
            held_until[x["pid"]] = True
        if x["ev"] in ("rel", "yld"):
            held_until.pop(x["pid"], None)
        if y["all"] > x["all"] and y["busy"] >= x["busy"]:
            s = sums["held" if held_until else "free"]
            s[0] += y["busy"] - x["busy"]
            s[1] += y["all"] - x["all"]
    hz = os.sysconf("SC_CLK_TCK") * ncpu
    print("\nbox CPU between log events: " + ", ".join(
        f"lock {k} {s[1] / hz / 60:.0f} min at {pct(s[0] / s[1])}" for k, s in sums.items() if s[1]))
    for lane, rs in (("the heavy lock", [x for x in runs if not x[0].get("lane")]), ("the short lane", [x for x in runs if x[0].get("lane")])):
        if rs:
            print(f"{lane}: {len(rs)} runs waited {sum(a['wait'] for a, _ in rs)/60:.0f} min, held {sum(r['held'] for _, r in rs)/60:.0f} min, "
                  f"{sum(r['cpu'] for _, r in rs):.0f} CPU-s" + (f", {sum(1 for _, r in rs if r.get('stop'))} stopped past a cap" if lane == "the short lane" else
                     f", {sum(1 for a, _ in rs if any(y['ev'] == 'yld' for y in a['yld']))} yielded as quiet"))


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--record"]:
        sys.exit(record(a[1:]))
    if a[:1] == ["--report"]:
        report(float(a[2]) if a[1:2] == ["--since"] and len(a) > 2 else 0)
        sys.exit()
    opts = {"--limit": None, "--log": None}
    short = False
    while a[:1] == ["--short"] or a[:1] and a[0] in opts and len(a) > 2:
        if a[0] == "--short":
            short, a = True, a[1:]
        else:
            opts[a[0]], a = a[1], a[2:]
    if not a or a[0].startswith("-") or short and opts["--limit"]:
        sys.exit(__doc__)
    sys.exit(run(a, opts["--limit"] or "heavy", opts["--log"], short))
