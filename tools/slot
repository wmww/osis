#!/usr/bin/env python3
"""Long-lived worktrees ("slots") that keep their target/ between tasks.

  tools/slot claim <branch> [<base>]   claim the lowest free slot, check out <branch>
                                       (made from <base>, default main, if new); prints its path
  tools/slot release [<slot>]          free a slot (default: the one containing cwd); it must be clean
  tools/slot list

Slots are <main checkout>-wt/slot<N> (/home/ai/osis-wt/slotN), created on first claim.
A task's first build in a slot recompiles only the crates whose sources differ from what the
slot built last (git rewrites only changed files; incremental state survives: same path).
A claim is a marker file in the common git dir, created atomically; release detaches HEAD
(files untouched, the branch is free to merge or delete) and removes the marker.
"""
import os, subprocess, sys, time
from pathlib import Path


def git(*args, cwd=None):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"slot: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
claims = common / "slot-claims"
home = common.parent.with_name(common.parent.name + "-wt")


def slot_of(arg):
    p = Path(arg) if arg else Path(git("rev-parse", "--show-toplevel"))
    p = p if p.is_absolute() or not arg else home / arg
    if p.parent != home or not p.name.startswith("slot"):
        sys.exit(f"slot: {p} is not a slot")
    return p


def claim(branch, base="main"):
    claims.mkdir(exist_ok=True)
    n = 1
    while True:
        try:
            fd = os.open(claims / f"slot{n}", os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            break
        except FileExistsError:
            n += 1
    path = home / f"slot{n}"
    os.write(fd, f"{branch} (claimed {time.strftime('%Y-%m-%d %H:%M')})\n".encode())
    os.close(fd)
    try:
        if not path.exists():
            git("worktree", "add", "--detach", str(path), base)
            print(f"slot: new slot {path}: its first build is a full one", file=sys.stderr)
        if git("status", "--porcelain", cwd=path):
            sys.exit(f"slot: {path} has uncommitted changes")
        exists = subprocess.run(["git", "rev-parse", "--verify", "-q", f"refs/heads/{branch}"],
                                cwd=path, capture_output=True).returncode == 0
        git("checkout", "-q", *([branch] if exists else ["-b", branch, base]), cwd=path)
    except SystemExit:
        (claims / f"slot{n}").unlink()
        raise
    print(path)


def release(arg=None):
    path = slot_of(arg)
    if git("status", "--porcelain", cwd=path):
        sys.exit(f"slot: {path} has uncommitted or untracked files; commit or remove them first")
    git("checkout", "-q", "--detach", cwd=path)
    (claims / path.name).unlink(missing_ok=True)


def show():
    for p in sorted(home.glob("slot*")):
        c = claims / p.name
        print(p, c.read_text().strip() if c.exists() else "free")


cmd, *rest = sys.argv[1:] or ["help"]
if cmd == "claim" and 1 <= len(rest) <= 2:
    claim(*rest)
elif cmd == "release" and len(rest) <= 1:
    release(*rest)
elif cmd == "list" and not rest:
    show()
else:
    sys.exit(__doc__)
