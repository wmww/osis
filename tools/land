#!/bin/sh
# tools/land: push HEAD to origin's main, the landing step (notes/coordination.md, The task loop).
# Pushes only when the tree has no uncommitted tracked change (policy would read what the push
# lacks), `tools/policy.py --baseline` passes on that tree, and HEAD contains origin/main as just
# fetched (refused, it lists the files both sides changed, whose crates' tests the rebase owes).
# One command, so no `;` or `echo $?` between the check and the push drops the check's exit (that
# pushed policy violations to main twice). `--delete BRANCH` then deletes origin's BRANCH (the
# landed branch's pushed copy), only after the push succeeded: a delete chained after a piped land
# ran though land refused. Exit 1 refused, else git push's.
set -eu
del=
if [ "${1:-}" = --delete ]; then
    del=${2:?land: --delete needs a branch name}
    [ "$del" != main ] || { echo "land: --delete main refused" >&2; exit 1; }
    shift 2
fi
[ $# -eq 0 ] || { echo "usage: tools/land [--delete BRANCH]" >&2; exit 1; }
cd "$(git rev-parse --show-toplevel)"
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "land: uncommitted changes: commit them or drop them first; not pushed" >&2; exit 1; }
git fetch -q origin main
git merge-base --is-ancestor origin/main HEAD || {
    # files both sides changed (docs aside): their crates' tests are owed after the rebase
    both=$({ git diff --name-only origin/main...HEAD; git diff --name-only HEAD...origin/main; } 2> /dev/null | sort | uniq -d | sed '/^\(notes\|spec\|issues\|docs\)\//d' | tr '\n' ' ')
    echo "land: HEAD lacks origin/main ($(git rev-list --count HEAD..origin/main) commits): git -c rerere.enabled=false rebase origin/main, read its result, then clippy and the tests of the crates of the files both sides changed (${both:-none}); not pushed" >&2; exit 1; }
python3 tools/policy.py --baseline || { echo "land: policy failed (above); not pushed" >&2; exit 1; }
echo "land: pushing $(git rev-list --count origin/main..HEAD) commits:" >&2
git log --oneline origin/main..HEAD >&2
git push -q origin HEAD:main
echo "land: main is $(git rev-parse --short HEAD)" >&2
[ -z "$del" ] || { git push -q origin --delete "$del" && echo "land: deleted origin/$del" >&2; }
