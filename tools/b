#!/usr/bin/env python3
"""Run cargo (or any command) in the one shared build checkout, queued.

  tools/b <cargo args...>     e.g. tools/b test --workspace
  tools/b -- <command...>     e.g. tools/b -- tools/sweep.sh

Every checkout of this repo builds in one plain directory, <main checkout>-build
(/home/ai/osis-build), with one target/. The wrapper takes an exclusive lock on
it (queueing behind whoever holds it), makes its sources an exact copy of the
calling checkout's tracked and untracked-but-not-ignored files, then runs the
command there, in the same subdirectory. Nothing is copied back.

Freshness: cargo rebuilds a path crate when a source is newer than its last
build. The sync rewrites only files whose content differs, so a changed file
(reverted ones too) gets the current time and identical files keep theirs:
cargo rebuilds exactly what differs from the last build, whoever ran it.

The lock fd is inherited by the command and all its children, so the lock is
held until every one of them exits, even if this process is killed. A killed
sync leaves a half-synced tree; the next sync fixes it (it compares content).
Inside a held lock (OSIS_B_HELD set) it just runs the command.
"""
import fcntl, os, subprocess, sys, time
from pathlib import Path


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True)
    if r.returncode:
        sys.exit(f"b: not in a git checkout of this repo ({r.stderr.decode().strip()})")
    return r.stdout.decode().strip()


def sync(src, dst):
    """Make dst's files (target/ and .b/ aside) byte-identical to src's listed ones."""
    out = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         cwd=src, capture_output=True, check=True).stdout
    want = {r for r in out.decode().split("\0") if r and os.path.lexists(src / r)}  # drops deleted-but-tracked
    changed = 0
    for rel in sorted(want):
        a, b = src / rel, dst / rel
        if a.is_symlink():
            link = os.readlink(a)
            if not (b.is_symlink() and os.readlink(b) == link):
                b.parent.mkdir(parents=True, exist_ok=True)
                if os.path.lexists(b):
                    subprocess.run(["rm", "-rf", b], check=True)
                os.symlink(link, b)
                changed += 1
            continue
        data = a.read_bytes()
        mode = a.stat().st_mode & 0o777
        try:
            same = not b.is_symlink() and b.stat().st_size == len(data) and b.read_bytes() == data
        except (FileNotFoundError, NotADirectoryError, IsADirectoryError):
            same = False
        if not same:
            b.parent.mkdir(parents=True, exist_ok=True)
            if b.is_symlink() or b.is_dir():
                subprocess.run(["rm", "-rf", b], check=True)
            tmp = b.with_name(f".{b.name}.b-tmp")
            tmp.write_bytes(data)
            os.chmod(tmp, mode)
            os.replace(tmp, b)  # new inode, current mtime
            changed += 1
        elif b.stat().st_mode & 0o777 != mode:
            os.chmod(b, mode)
    removed = 0
    for root, dirs, files in os.walk(dst, topdown=True):
        r = Path(root).relative_to(dst)
        if r == Path("."):
            dirs[:] = [d for d in dirs if d not in ("target", ".b")]
        for f in files:
            if (r / f).as_posix() not in want:
                os.unlink(Path(root) / f)
                removed += 1
    for root, dirs, files in os.walk(dst, topdown=False):  # empty dirs left by deletions
        p = Path(root)
        if p != dst and p.relative_to(dst).parts[0] not in ("target", ".b") and not any(p.iterdir()):
            p.rmdir()
    return changed, removed


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)
    cmd = args[1:] if args[0] == "--" else ["cargo", *args]
    if not cmd:
        sys.exit(__doc__)
    if os.environ.get("OSIS_B_HELD"):
        os.execvp(cmd[0], cmd)

    top = Path(git("rev-parse", "--show-toplevel"))
    main_co = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent
    build = main_co.with_name(main_co.name + "-build")
    (build / ".b").mkdir(parents=True, exist_ok=True)
    lock = os.open(build / ".b" / "lock", os.O_RDWR | os.O_CREAT, 0o644)
    who = build / ".b" / "holder"
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        try:
            held = who.read_text().strip()
        except OSError:
            held = "?"
        print(f"b: waiting for build lock held by {held}", file=sys.stderr, flush=True)
        t = time.monotonic()
        fcntl.flock(lock, fcntl.LOCK_EX)
        print(f"b: got the lock after {time.monotonic() - t:.0f} s", file=sys.stderr, flush=True)
    who.write_text(f"{top} pid {os.getpid()}: {' '.join(cmd)} (since {time.strftime('%H:%M:%S')})\n")

    t = time.monotonic()
    changed, removed = sync(top, build)
    if changed or removed:
        print(f"b: synced {top} -> {build}: {changed} written, {removed} removed "
              f"({time.monotonic() - t:.1f} s)", file=sys.stderr, flush=True)
    if (top / "target").exists():
        print(f"b: warning: {top}/target exists; builds happen in {build}: delete it", file=sys.stderr)

    os.chdir(build / Path.cwd().relative_to(top) if Path.cwd().is_relative_to(top) else build)
    os.environ["OSIS_B_HELD"] = str(build)
    os.set_inheritable(lock, True)  # the command and its children hold the lock until all exit
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        sys.exit(f"b: {cmd[0]}: {e}")


if __name__ == "__main__":
    main()
