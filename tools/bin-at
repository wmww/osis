#!/bin/sh
# tools/bin-at REV OUT [--release] [-p CRATE] [--test NAME | --lib CRATE] [--patch FILE]... [--take PATH]...:
# REV's test binary (default osis-node's `it`, dev profile; `--lib CRATE`: that crate's lib unit
# tests, e.g. osis-engine's `rotation::tests`), built in this worktree and copied to
# OUT, for old-vs-new runs and `tools/icount` comparisons (notes/build.md). To build a new test
# against an old REV: `--patch FILE` applies a diff (`git apply --index`) on top of REV, `--take
# PATH` (a file or directory) copies PATH as the starting commit holds it (`git checkout <start>
# -- PATH`, root-relative); both undone before returning (`git reset --hard`). Needs a clean tree
# (wip-commit first): checks out REV detached, builds, checks the starting branch or commit out again (also on failure). The
# next build here recompiles what REV changed back. The binary keeps this worktree's manifest
# dirs: a test reading fixtures reads the checked-out ones. Refuses the main checkout (build only
# in task worktrees). Killed hard (SIGKILL) mid-build, it leaves HEAD detached at REV: check the
# branch it printed out again. Interrupted mid-build (seen with Ctrl-C), the next build here may
# fail to link with undefined symbols: delete the newest target/debug/incremental/{it,osis_node,
# osis_engine}-* dirs.
set -eu
usage="usage: tools/bin-at REV OUT [--release] [-p CRATE] [--test NAME | --lib CRATE] [--patch FILE]... [--take PATH]..."
[ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
rev=$1 out=$2
shift 2
profile="" crate=osis-node test=it lib="" patches="" takes=""
nl='
'
while [ $# -gt 0 ]; do
    case $1 in
        --release) profile=--release ;;
        -p) crate=$2; shift ;;
        --test) test=$2; shift ;;
        --lib) crate=$2 lib=1; shift ;;
        --patch) [ -f "$2" ] || { echo "bin-at: no patch file $2" >&2; exit 2; }
            patches="$patches$(cd "$(dirname "$2")" && pwd)/$(basename "$2")$nl"; shift ;;
        --take) takes="$takes$2$nl"; shift ;;
        *) echo "bin-at: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
root=$(git rev-parse --show-toplevel)
cd "$root"
[ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ] || { echo "bin-at: main checkout; run it in a task worktree (tools/wt claim)" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "bin-at: uncommitted changes; wip-commit them first" >&2; exit 1; }
sha=$(git rev-parse --verify "$rev^{commit}")
back=$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)
start=$(git rev-parse HEAD)
dirty=
# a patch or take changed the tree at REV: drop it (tracked and index-added files) first
restore() { [ -z "$dirty" ] || git reset -q --hard; git checkout -q "$back"; }
trap restore EXIT
trap 'exit 1' HUP INT TERM
echo "bin-at: building $sha detached; returns to $back (if killed: git checkout $back)" >&2
git checkout -q --detach "$sha"
dirty=1
IFS=$nl
for f in $patches; do git apply --index "$f" || { echo "bin-at: $f does not apply to $sha" >&2; exit 1; }; done
for f in $takes; do git checkout -q "$start" -- "$f" || exit 1; done
unset IFS
[ -n "$patches$takes" ] || dirty=
if [ -n "$lib" ]; then
    target="--lib" pick='.profile.test and (.target.kind | index("lib"))'
else
    target="--test $test" pick='.target.name == "'"$test"'"'
fi
# shellcheck disable=SC2086
exe=$(cargo test $profile -p "$crate" $target --no-run --message-format=json-render-diagnostics \
    | jq -r 'select(.reason == "compiler-artifact" and .executable != null and '"$pick"') | .executable' | tail -n 1)
[ -n "$exe" ] || { echo "bin-at: no executable for $crate $target" >&2; exit 1; }
mkdir -p "$(dirname "$out")"
cp "$exe" "$out"
echo "bin-at: $(git log -1 --format='%h %s' "$sha")${patches:+ + patches}${takes:+ + taken files} -> $out" >&2
