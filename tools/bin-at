#!/bin/sh
# tools/bin-at REV OUT (-p CRATE [--test NAME | --bin NAME] | --lib CRATE) [--release] [--patch FILE]... [--take PATH]... [--take-at REV2 PATH]...:
# REV's test binary (CRATE's `it`, or `--test NAME`, dev profile; `--lib CRATE`: that crate's lib
# unit tests, e.g. osis-engine's `rotation::tests`; `--bin NAME`: CRATE's binary NAME, e.g. a model's
# search driver `-p roles-model --bin roles-model`), built in this worktree and copied to
# OUT, for old-vs-new runs and `tools/icount` comparisons (notes/build.md). To build a new test
# against an old REV: `--patch FILE` applies a diff (`git apply --index`) on top of REV, `--take
# PATH` (a file or directory, root-relative) replaces PATH with the starting commit's copy (files
# the start lacks removed), `--take-at REV2 PATH` with REV2's (tools/src-at: a library's sources at
# another revision); all undone before returning (`git reset --hard`). Needs a clean tree
# (wip-commit first): checks out REV detached, builds, checks the starting branch or commit out again (also on failure). OUT
# is the only copy of REV's binary: every executable it compiled at REV is deleted from target/
# (cargo's path for it is the branch's, so running that path later would run REV's code). The
# next build here recompiles what REV changed back. Several binaries at several revisions: one
# spare worktree (`wt claim <name> <rev>`) per revision building them in one `cargo test -p A -p B
# --no-run --message-format=json` costs one build each, where bin-at per binary rebuilds twice. The binary keeps this worktree's manifest
# dirs: a test reading fixtures reads the checked-out ones. Refuses the main checkout (build only
# in task worktrees). Killed hard (SIGKILL) mid-build, it leaves HEAD detached at REV: check the
# branch it printed out again. Interrupted mid-build (seen with Ctrl-C), the next build here may
# fail to link with undefined symbols: `cargo clean -p <crate>` for the crate the error names
# (notes/build.md, Footguns; deleting incremental dirs leaves a fresh-looking rlib unrebuilt).
set -eu
usage="usage: tools/bin-at REV OUT (-p CRATE [--test NAME | --bin NAME] | --lib CRATE) [--release] [--patch FILE]... [--take PATH]... [--take-at REV2 PATH]..."
[ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
rev=$1 out=$2
shift 2
profile="" crate="" test=it lib="" bin="" patches="" takes=""
nl='
'
while [ $# -gt 0 ]; do
    case $1 in
        --release) profile=--release ;;
        -p) crate=$2; shift ;;
        --test) test=$2; shift ;;
        --lib) crate=$2 lib=1; shift ;;
        --bin) bin=$2; shift ;;
        --patch) [ -f "$2" ] || { echo "bin-at: no patch file $2" >&2; exit 2; }
            patches="$patches$(cd "$(dirname "$2")" && pwd)/$(basename "$2")$nl"; shift ;;
        # each take a line `REV2 PATH` (REV2 empty: the starting commit)
        --take) takes="$takes $2$nl"; shift ;;
        --take-at) [ $# -ge 3 ] || { echo "$usage" >&2; exit 2; }
            r=$(git rev-parse --verify -q "$2^{commit}") || { echo "bin-at: no revision $2" >&2; exit 2; }
            takes="$takes$r $3$nl"; shift 2 ;;
        *) echo "bin-at: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
# no default crate: the binary wanted is the one whose test is compared
[ -n "$crate" ] || { echo "bin-at: name the crate (-p CRATE or --lib CRATE)" >&2; echo "$usage" >&2; exit 2; }
root=$(git rev-parse --show-toplevel)
cd "$root"
[ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ] || { echo "bin-at: main checkout; run it in a task worktree (wt claim)" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "bin-at: uncommitted changes; wip-commit them first" >&2; exit 1; }
sha=$(git rev-parse --verify "$rev^{commit}")
back=$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)
start=$(git rev-parse HEAD)
dirty=
# a patch or take changed the tree at REV: drop it (tracked and index-added files) first
restore() { [ -z "$dirty" ] || git reset -q --hard; git checkout -q "$back"; }
trap restore EXIT
trap 'exit 1' HUP INT TERM
echo "bin-at: building $sha detached; returns to $back (if killed: git checkout $back). Until then the tree is $sha's: edit nothing, read the branch as git show $back:PATH" >&2
git checkout -q --detach "$sha"
dirty=1
IFS=$nl
for f in $patches; do git apply --index "$f" || { echo "bin-at: $f does not apply to $sha" >&2; exit 1; }; done
for t in $takes; do
    r=${t%% *} f=${t#* }
    git rm -rq --ignore-unmatch -- "$f" > /dev/null && git checkout -q "${r:-$start}" -- "$f" || { echo "bin-at: no $f at ${r:-$start}" >&2; exit 1; }
done
unset IFS
[ -n "$patches$takes" ] || dirty=
if [ -n "$lib" ]; then
    target="--lib" pick='.profile.test and (.target.kind | index("lib"))'
elif [ -n "$bin" ]; then
    target="--bin $bin" pick='.target.name == "'"$bin"'" and (.target.kind | index("bin"))'
else
    target="--test $test" pick='.target.name == "'"$test"'"'
fi
json=$(mktemp)
trap 'rm -f "$json"; restore' EXIT
# shellcheck disable=SC2086
if [ -n "$bin" ]; then
    cargo build $profile -p "$crate" $target --message-format=json-render-diagnostics > "$json"
else
    cargo test $profile -p "$crate" $target --no-run --message-format=json-render-diagnostics > "$json"
fi
exe=$(jq -r 'select(.reason == "compiler-artifact" and .executable != null and '"$pick"') | .executable' "$json" | tail -n 1)
[ -n "$exe" ] || { echo "bin-at: no executable for $crate $target" >&2; exit 1; }
mkdir -p "$(dirname "$out")"
cp "$exe" "$out"
# Every executable this build compiled at REV is deleted from the target: the path is the one
# cargo builds the branch's binary at (the hash does not follow the sources), so a direct run of
# it would run REV's code until the next build. Deleted, it cannot; the next build compiles it
# again, as it would anyway (the checkout back touched what REV changed). Executables cargo found
# fresh were built from these same sources and stay.
jq -r 'select(.reason == "compiler-artifact" and .executable != null and .fresh == false) | .executable' "$json" \
    | while IFS= read -r x; do rm -f "$x"; done
echo "bin-at: $(git log -1 --format='%h %s' "$sha")${patches:+ + patches}${takes:+ + taken files} -> $out" >&2
