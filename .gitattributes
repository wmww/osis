# One-item-per-line lists that concurrent branches add to: union merge keeps both sides of a
# conflicting hunk. A line both sides added comes twice and a line one side removed beside the
# other's change comes back; tools/policy.py (`union_lists`) refuses both. Not for
# notes/time-limits.md: a digest deleting hits beside an append would bring the hits back.
tools/known_failures.txt merge=union
tools/dead_pub_allow.txt merge=union
core/base/testenv-known.txt merge=union
