<?xml version="1.0" encoding="utf-8"?>
<!-- The osis app on Android (notes/android.md): OsisActivity (java/) shows OsisView, run by libosis_android.so. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.osis.app" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="osis" android:allowBackup="false" android:extractNativeLibs="true">
        <activity android:name="net.osis.app.OsisActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
