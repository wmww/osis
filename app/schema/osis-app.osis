//! The app's own aspects (notes/app.md). Notes are core `/name` plus `/body`, tags core `/tag` groups,
//! events and contacts the first-party schemas (schema/).
schema 0x1479f2511b02a554fda5785da8c52882;
revision 1;

/// Marks a group as the app's internal group (an item and subgroup of home, no `/tag`, never shown).
/// Every thing the app makes is placed in it; the app's own per-person data lives on it.
aspect /osis-app/app: bool;
/// On the app group: the favorites, in the person's order.
aspect /osis-app/favorites: list<tid>;
/// Marks a thing as one of the app's built-in views (a scope tile like a tag).
aspect /osis-app/view: enum { 0 calendar, 1 people, 2 tags, 3 recent };
/// A thing's own display colour (`#rrggbb`) where no first-party aspect holds one (a tag's is `/tag.color`).
aspect /osis-app/color: string;
/// On the app group: the thing each device (its node tid) has open; absent: home.
aspect /osis-app/open: map<tid, tid> [ephemeral];
/// On the app group: demo data was added.
aspect /osis-app/demo: bool;
/// On the app group: the person's theme (a built-in theme's id).
aspect /osis-app/theme: string;
/// On the app group: light, dark, or following the system.
aspect /osis-app/mode: enum { 0 auto, 1 light, 2 dark };
/// On the app group: revocations still to do (a tag's access to a thing, kept after the tag was
/// removed while offline); retried until they succeed or no longer apply.
aspect /osis-app/revoke: set<struct { 0 thing: tid, 1 tag: tid }>;
