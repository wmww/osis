//! The app's own aspects (notes/app.md). Notes are core `name.0` plus `body.0`, tags core `tag.0` groups,
//! events and contacts the first-party schemas (schema/).
schema 0x1479f2511b02a554fda5785da8c52882;
revision 1;

/// Marks a group as the app's internal group (an item and subgroup of home, no `tag.0`, never shown).
/// Every thing the app makes is placed in it; the app's own per-person data lives on it.
aspect osis_app:app.0: bool;
/// On the app group: the favorites, in the person's order.
aspect osis_app:favorites.0: list<tid>;
/// Marks a thing as one of the app's built-in views (a scope tile like a tag).
aspect osis_app:view.0: enum { 0 calendar, 1 people, 2 tags, 3 recent };
/// A thing's own display colour (`#rrggbb`) where no first-party aspect holds one (a tag's is `tag.0` color).
aspect osis_app:color.0: string;
/// On the app group: the thing each device (its node tid) has open; absent: home.
aspect osis_app:open.0~: map<tid, tid> [ephemeral];
/// On the app group: demo data was added.
aspect osis_app:demo.0: bool;
/// On the app group: the person's theme (a built-in theme's id).
aspect osis_app:theme.0: string;
/// On the app group: light, dark, or following the system.
aspect osis_app:mode.0: enum { 0 auto, 1 light, 2 dark };
