# Run by `wt release` before it prunes the target: every standard command (notes/build.md), so
# units a task skipped stay. Each is a no-op on a gated tree.
set -e
# Build key: with it unchanged since the last marking no unit can be stale (a workspace crate's
# edit rebuilds its unit in place), so mark every unit as read and let wt prune only incremental/
# (seconds; marking builds every target a worker never built: about a minute per release).
key=$( { cat Cargo.lock .cargo/config.toml; git ls-files -z '*Cargo.toml' | xargs -0 cat; rustc -vV; } | sha256sum)
if [ -f target/.wt-mark-key ] && [ "$(cat target/.wt-mark-key)" = "$key" ]; then
  find target -path '*/.fingerprint/*' -type f -exec touch -a {} +
  exit 0
fi
rm -f target/.wt-mark-key
cargo test --no-run
cargo build --all-targets
cargo clippy --all-targets -- -D warnings
# The GUI's, where they were built before (an rmeta: linted; an rlib: built): marking never builds
# the GUI stack cold.
gui="-p osis-kit -p osis-app -p osis-android"
if ls target/debug/deps/libosis_kit-*.rmeta >/dev/null 2>&1; then
  cargo clippy $gui --all-targets -- -D warnings
fi
if ls target/aarch64-linux-android/debug/deps/libosis_android-*.rmeta >/dev/null 2>&1; then
  app/android/with-ndk aarch64-linux-android cargo clippy -p osis-android --target aarch64-linux-android -- -D warnings
fi
if ls target/debug/deps/libosis_kit-*.rlib >/dev/null 2>&1; then
  cargo test $gui --no-run
fi
echo "$key" > target/.wt-mark-key
