+
+/// osis-kit patch: the clipboard of the event loop's display: Wayland through the loop's own
+/// connection, else X11, else a nop clipboard (upstream unwrapped the X11 one, which panics on a
+/// Wayland-only session).
+#[allow(unsafe_code, reason = "the Wayland clipboard takes the raw display pointer")]
+fn make_clipboard(event_loop: &ActiveEventLoop) -> Box<dyn ClipboardProvider> {
+    #[cfg(all(unix, not(any(target_os = "macos", target_os = "android", target_os = "ios", target_os = "emscripten"))))]
+    {
+        use winit::raw_window_handle::{HasDisplayHandle, RawDisplayHandle};
+        if let Ok(h) = event_loop.display_handle()
+            && let RawDisplayHandle::Wayland(w) = h.as_raw()
+        {
+            // SAFETY: the display pointer is the event loop's live wl_display, which outlives
+            // every window and so the clipboard kept in MasonryState.
+            let (_, clip) = unsafe { copypasta::wayland_clipboard::create_clipboards_from_external(w.display.as_ptr()) };
+            return Box::new(clip);
+        }
+    }
+    let _ = event_loop;
+    match copypasta::ClipboardContext::new() {
+        Ok(c) => Box::new(c),
+        Err(_) => Box::new(copypasta::nop_clipboard::NopClipboardContext),
+    }
+}
