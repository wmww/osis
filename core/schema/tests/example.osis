//! Test fixture, not a real schema: covers the DSL's features for osis-schema's own tests.
revision 4; // bumped on every publish

type priority = enum {
    low 0,
    medium 1,
    high 2,
    custom 3 (int),
};

type status = enum {
    todo 0,
    doing 1,
    done 2,
    blocked 3,
};

/// A task inside a note.
type task = struct {
    title 1: string,
    done 2: bool,
    tags 3: set<string>,
    priority 4: option<priority>, // option defaults to none
    weight 8: float = 1.0,        // numbers in any order
    due 6: option<timestamp>,
    status 7: option<status> succeeds 2, // new form for `done`
    reserved 5,
};

/// A labelled value; parametric.
type tagged<T> = struct {
    label 0: string,
    value 1: T,
};

/// Markdown; not guaranteed valid.
aspect note:body.0: markdown;

aspect note:title.0: string;

/// A new version of `note:title.0`, which it succeeds.
aspect note:title.1: text;

aspect note:tasks.0: list<task>;

aspect note:views.0: counter<int>;

expires(30d) aspect note:last_opened.0: timestamp;

purgeable_by(writer) aspect note:pinned.0: map<tid, tagged<int>>;

/// Old titles.
purgeable_by(author, admin) aspect note:aliases.0: set<string>;

/// Where each device's cursor is; only admins set it.
expires(30s) ephemeral admin aspect note:cursor+^.0: map<tid, int>;

/// Someone is typing in the note.
ephemeral signal note:typing+~0: struct {
    who 0: tid,
    at 1: timestamp,
};
