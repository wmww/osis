//! The schema of schemas: a parsed schema is a value of type `schema` (spec/data-model.md §10).
version 1;

type schema = struct {
    0 version: int,
    /// By type name.
    1 types: map<string, type_def>,
    /// By AK.
    2 aspects: map<string, aspect_def>,
    3 doc: option<string>,
};
type type_def = struct { 0 params: list<string>, 1 body: type_expr, 2 doc: option<string> };
type type_expr = enum {
    0 string, 1 blob, 2 bool, 3 int, 4 float, 5 tid, 6 any, 7 text,
    8 list(type_expr), 9 set(type_expr), 10 map(struct { 0 key: type_expr, 1 value: type_expr }),
    11 struct(struct { 0 fields: map<int, field_def>, 1 reserved: set<int> }),
    12 enum(struct { 0 cases: map<int, case_def>, 1 reserved: set<int> }),
    13 counter(type_expr), 14 max(type_expr), 15 min(type_expr),
    /// A type declared in the schema, or a standard one (`option`, `markdown`, `timestamp`, ...).
    16 named(struct { 0 name: string, 1 args: list<type_expr> }),
    /// A parameter of the enclosing `type_def`.
    17 param(string),
};
/// `succeeds`: the IDs this field or case replaces.
type field_def = struct { 0 name: string, 1 type: type_expr, 2 default: option<any>, 3 succeeds: set<int>, 4 doc: option<string> };
type case_def = struct { 0 name: string, 1 payload: option<type_expr>, 2 succeeds: set<int>, 3 doc: option<string> };
/// How long replaced values stay readable as history: until a time (2^63 - 1: forever) and/or for
/// a duration after being replaced.
type keep = struct { 0 until: option<timestamp>, 1 after: option<duration> };
type history = enum { 0 keep(keep), 1 purge_on_replace };
/// Who may purge the aspect, and its history (absent: none promised).
type retention = struct { 0 by: enum { 0 nobody, 1 admin, 2 author_or_admin, 3 writer, 4 author }, 1 history: option<history> };
type flag = enum { 0 ro, 1 synthetic, 2 guaranteed, 3 indexed };
type aspect_def = struct {
    0 type: type_expr,
    /// The default retention of writes.
    1 retention: retention,
    /// Default expiry, after the write.
    2 expires: option<duration>,
    3 flags: set<flag>,
    /// The AKs this one replaces.
    4 succeeds: set<string>,
    5 doc: option<string>,
};
