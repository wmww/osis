//! Core schema (spec/data-model.md §9). Agility enums and the creation record: spec/wire.md §3.
version 1;

type signing_key = enum { 1 ed25519(blob) };          // 32 bytes
type signature = enum { 1 ed25519(blob) };            // 64 bytes
type kem_key = enum { 1 x25519_mlkem768(blob) };      // pk_x || pk_m, 1216 bytes
type sealed = enum { 1 x25519_mlkem768(blob) };       // ct_x || ct_m || AEAD
/// Exactly one of fields 0, 1 and 3 (spec/wire.md §3); typed through `CreationRecord`.
type creation = struct { 0 owner: tid, 1 key: signing_key, 2 nonce: blob, 3 admin: tid };

type role = enum { 0 read, 1 write, 2 admin };
type epoch = struct { 0 n: int, 1 nonce: blob };                 // nonce: 32 bytes (spec/crypto.md §4)
type address = struct { 0 url: string, 1 key: blob };            // transport URL, 32-byte host static key
type source = enum { 0 commit(blob), 1 session(blob) };   // a dot's source (spec/crdt.md §2.1); commit: 32-byte commit ID; session: 31 bytes, tid then nonce (spec/crdt.md §3.2)
/// An aspect a heartbeat reports suspect, with its keyed state digest (16 bytes, spec/permissions.md §4).
type suspect = struct { 0 thing: tid, 1 ak: string, 2 digest: blob };
type tie = struct { 0 ts: int, 1 source: source, 2 ctr: int, 3 subgroup: bool };   // creation stamp of a group.0 element and its set
type edge = struct { 0 role: role, 1 until: option<timestamp>, 2 invite: option<role>, 3 tied: option<tie> };
type keyset = struct { 0 epoch: epoch, 1 kem_key: kem_key, 2 suite: int, 3 delete_key: signing_key, 4 supersedes: set<epoch>, 5 possession_key: signing_key };   // suite ID of the epoch; delete key: spec/crypto.md §7; supersedes, possession key: spec/crypto.md §4
type inbox = struct { 0 label: blob, 1 hosts: list<address> };  // label ID: 16 bytes
type box_key = struct { 0 holder: tid, 1 role: role, 2 epoch: epoch };
type box = enum {
    0 sealed(struct { 0 keyset: option<epoch>, 1 suite: int, 2 box: sealed }),
    1 symmetric(struct { 0 epoch: epoch, 1 wrap: blob, 2 possession: option<signature> }),     // epoch of s; wrap, possession: spec/wire.md §7
};
type history_key = struct { 0 role: role, 1 epoch: epoch };
type frontier = struct { 0 commits: set<blob> };   // 32-byte commit IDs of what the demoter received (spec/permissions.md §5.1)
type step_record = struct { 0 step: blob, 1 claims: option<blob> };   // spec/wire.md §8 bytes
type label = struct { 0 index: int, 1 steps: map<blob, step_record>, 2 hosts: list<address>, 3 replaced: bool };
type admit = enum { 0 own, 1 open };
type host_caps = struct { 0 entries: int, 1 bytes: int };       // a label's caps in place of the policy's
/// A thin client of the node: BLAKE3 of its bearer secret (32 bytes), when it ends.
type client = struct { 0 secret_hash: blob, 1 until: option<timestamp> };
type bound = struct { 0 abs: option<timestamp>, 1 rel: option<duration> };
type required = struct { 0 by: enum { 0 nobody, 1 admin, 2 author_or_admin, 3 writer, 4 author }, 1 at_least: bound, 2 at_most: bound, 3 expires: option<duration> };
type required_rules = struct { 0 rules: map<string, required>, 1 retain: bool };

aspect tid.0: tid [synthetic, guaranteed];
/// AKs present on the thing.
aspect aspects.0: set<string> [synthetic, guaranteed];
aspect created.0: creation [guaranteed, by: nobody];
aspect roles.0: map<tid, edge> [by: admin, keep_at_least: 90d];
aspect keys.0: struct {
    0 read: option<keyset>, 1 write: option<keyset>, 2 admin: option<keyset>,   // actors other than key actors
    3 key: option<kem_key>,                                                       // a key actor's one KEM key
    4 inbox: option<inbox>, 5 deposit_seed: option<blob>,                        // deposit seed: 32 bytes
} [by: admin, keep_at_least: 90d];
aspect secrets.0: struct { 0 boxes: map<box_key, box>, 1 history: map<history_key, blob> } [by: admin, keep_at_least: 90d];
/// Label ID -> label.
aspect label.0: map<blob, label> [by: admin, keep_at_least: 90d];
aspect node.0: struct { 0 software: string };
/// 32-byte P2P key, relay URLs, 32-byte LAN secret.
aspect reach.0: struct { 0 dialable: blob, 1 relays: list<string>, 2 lan_secret: blob };
/// ts: wall ms of the commit's ts.
aspect seen.0: struct { 0 ts: timestamp, 1 stranded: bool, 2 suspect: set<suspect> };
/// Hosting, on a node thing (absent: not hosting): listen URLs, admission, label IDs (16 bytes) admitted beside `own`'s, peer hosts to replicate to, policy knobs by name, per-label caps by label ID.
aspect host.0^: struct { 0 listen: list<string>, 1 admit: admit, 2 labels: set<blob>, 3 replicate: list<address>, 4 policy: map<string, int>, 5 caps: map<blob, host_caps> };
/// Thin clients of this node by client actor.
aspect clients.0^: map<tid, client>;
/// The retention this thing requires, by AK prefix (spec/commits.md §5), and whether a removal from it
/// retains a copy by default (spec/permissions.md §3).
aspect required.0^: required_rules;
/// When a purge request by name or by author was last made here: the delta such a commit carries, no
/// read of the purged aspect changed by it (spec/commits.md §5).
aspect purge.0: timestamp;
aspect group.0: struct { 0 items: set<tid> = [], 1 subgroups: set<tid> = [] };
/// A group's ephemeral members: items and subgroups added while ephemeral (spec/data-model.md §8), read with group.0. Written by group ops only.
aspect ephemeral_group.0~: struct { 0 items: set<tid> = [], 1 subgroups: set<tid> = [] };
aspect groups.0: set<tid> [synthetic, guaranteed];

/// What humans call the thing.
aspect name.0: string;
/// Freeform markdown: a note's content, notes on an event or a contact.
aspect body.0: markdown;
/// Marks a group as a user-facing tag (notes/tags.md): its items are the tag's contents, its subgroups its sub-tags.
aspect tag.0: struct { 0 color: option<string> };
