+    /// Where the descendant `id` was last placed, in this widget's coordinates (its own and its
+    /// ancestors' origins below this widget); `None` when it is not a descendant.
+    pub fn descendant_origin(&self, id: WidgetId) -> Option<Point> {
+        let me = self.widget_state.id.to_raw();
+        let mut at = Vec2::ZERO;
+        let mut cur = id.to_raw();
+        loop {
+            let node = self.children.find(cur)?;
+            at += node.item.state.origin.to_vec2();
+            match node.parent_id {
+                Some(p) if p == me => return Some(at.to_point()),
+                Some(p) => cur = p,
+                None => return None,
+            }
+        }
+    }
+
+    /// The focused widget's IME area (a text field's caret; else its box), in this widget's
+    /// coordinates, when it is a descendant.
+    pub fn focused_area(&self) -> Option<Rect> {
+        let id = self.global_state.focused_widget?;
+        let at = self.descendant_origin(id)?;
+        let node = self.children.find(id.to_raw())?;
+        let state = &node.item.state;
+        Some(state.ime_area.unwrap_or_else(|| state.size().to_rect()) + at.to_vec2())
+    }
+
+    /// Asks the scroll pass (after this layout) to bring the focused widget's IME area into view.
+    pub fn request_scroll_to_focused(&mut self) {
+        let Some(id) = self.global_state.focused_widget else { return };
+        let Some(node) = self.children.find(id.to_raw()) else { return };
+        let state = &node.item.state;
+        let area = state.ime_area.unwrap_or_else(|| state.size().to_rect());
+        self.global_state.scroll_request_targets.push((id, area));
+    }
+
+    /// Marks the descendant `id` (and the widgets between) as needing layout, so this widget's
+    /// next `run_layout` on its child reaches it even under constraints it was laid out at before.
+    pub fn request_layout_of(&mut self, id: WidgetId) {
+        let me = self.widget_state.id.to_raw();
+        let mut cur = id.to_raw();
+        loop {
+            let Some(node) = self.children.reborrow_mut().find_mut(cur) else { return };
+            node.item.state.needs_layout = true;
+            match node.parent_id {
+                Some(p) if p != me => cur = p,
+                _ => return,
+            }
+        }
+    }
