//! Contacts and profiles. A contact is any thing with one or more of these aspects, kept by whoever
//! made it; a profile is the same aspects on a person's own profile thing, written by that person.
//! Display name: `name.0`; notes: `body.0`; groups of contacts: tags.
revision 1;

/// An entry's label (home, work, mobile, ...) and whether it is the preferred one of its kind.
type labeled = struct {
    label 0: string = "",
    pref 1: bool = false,
};

type address = struct {
    street 0: string = "",
    city 1: string = "",
    region 2: string = "",
    postal 3: string = "",
    country 4: string = "",
};

/// A date that comes back every year; without a year, the year is unknown.
type annual = struct {
    month 0: int,
    day 1: int,
    year 2: option<int>,
};

/// The profile of the osis user this contact is. The contact's own values override the profile's,
/// field by field.
keep_history(1d) aspect contact:profile.0: tid;

keep_history(1d) aspect contact:names.0: struct {
    given 0: option<string>,
    family 1: option<string>,
    middle 2: option<string>,
    prefix 3: option<string>,
    suffix 4: option<string>,
};

keep_history(1d) aspect contact:nickname.0: string;

/// Keyed by the address.
keep_history(1d) aspect contact:emails.0: map<string, labeled>;

/// Keyed by the number as entered.
keep_history(1d) aspect contact:phones.0: map<string, labeled>;

keep_history(1d) aspect contact:urls.0: map<string, labeled>;

/// Keyed by label: home, work, ...
keep_history(1d) aspect contact:addresses.0: map<string, address>;

/// Keyed by label: birthday, anniversary, ...
keep_history(1d) aspect contact:dates.0: map<string, annual>;

keep_history(1d) aspect contact:org.0: struct {
    name 0: string = "",
    department 1: string = "",
    title 2: string = "",
};

/// Messaging and social accounts.
keep_history(1d) aspect contact:accounts.0: set<struct {
    service 0: string,
    handle 1: string,
}>;

/// Another contact -> how they are related (spouse, child, ...).
keep_history(1d) aspect contact:relations.0: map<tid, string>;
