//! Group chat. A chat is one thing; its participants hold write on it.
version 1;

/// What editing a message does to its old text.
type edit_mode = enum {
    /// The old text is purged.
    0 purge,
    /// The old text stays readable as edit history.
    1 keep,
    /// Messages cannot be edited.
    2 off,
};

/// The messages: every write is one message, kept for good, and the aspect's history is the chat.
/// Sender and time are the write's own. Each write is the CBOR bytes of a map: `0` text, `3` the
/// sender's display name, `4` the message it replies to; an edit also has `1` the original message
/// and `2` every earlier version it replaces. Messages are named by their place in the history.
aspect chat:msgs.0: blob;
aspect chat:settings.0^: struct { 0 name: string, 1 edit: edit_mode };
