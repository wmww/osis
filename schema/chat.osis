//! Group chat. A chat is one thing; its participants hold write on it.
version 1;

/// What editing a message does to its old text.
type edit_mode = enum {
    /// The old text is purged.
    0 purge,
    /// The old text stays readable as edit history.
    1 keep,
    /// Messages cannot be edited.
    2 off,
};

/// A message: its place in the chat's history, as the text form of its history position.
type msg_id = string;

/// An edit: the message it changes and every earlier version it replaces. Honored only when the
/// original is the same sender's and no edit itself; else it is a message of its own.
type edit = struct { 0 original: msg_id, 1 prior: set<msg_id> };

/// One message.
type message = struct {
    0 text: string,
    /// The sender's display name, their own word.
    1 name: option<string>,
    /// The message it answers.
    2 reply_to: option<msg_id>,
    3 edit: option<edit>,
};

/// The messages: every write is one message, kept for good, and the aspect's history is the chat.
/// Sender and time are the write's own.
aspect chat:msgs.0: message;
aspect chat:settings.0^: struct { 0 name: string, 1 edit: edit_mode };
