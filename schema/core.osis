//! Core schema: the aspects every osis node understands. Apps mostly use the "Content" and
//! "Tags" sections and the read-only identity aspects; the rest are records osis itself keeps
//! (who may do what, keys, syncing, devices), whose exact rules are in the spec section named.
revision 1;

// ---- Identity ----
// What every thing has from the start: its tid, which aspects it has, and how it was created.

/// The AKs present on the thing.
synthetic guaranteed aspect aspects.0: set<string>;

/// A public signing key. ed25519: 32 bytes.
type signing_key = enum {
    ed25519 1 (blob),
};

/// How a thing was created (spec/wire.md §3). Exactly one of `admin` and `key` is set:
/// - `admin`: the thing's mint admin;
/// - `key`: the thing is minted with this public key (a node thing or a share-link key),
///   which holds admin on it from the start. It has no mint admin.
/// `link`: beside `admin`, the thing is a share link's thing K, made for this target; beside
/// `key`, it is the link's key, holding a grant on this K.
/// `expires`, only beside `admin`: the wall ms the thing ends at, whole, whatever any later
/// creation of it says.
type creation = struct {
    admin 0: weak,
    key 1: signing_key,
    nonce 2: blob,
    link 3: weak,
    expires 5: timestamp,
};

guaranteed aspect created.0: creation;

// ---- Content ----
// General-purpose aspects any app can use, so that apps agree on what to call and show a thing.

/// What humans call the thing.
aspect name.0: string;

/// Freeform content: a note's text, or notes on anything else.
aspect body.0: markdown;

// ---- References ----
// What a thing holds (spec/data-model.md §8): a strong says its target belongs with this thing,
// a weak only points.

/// Strongs and weaks. A node holds what its node root reaches by strongs; a tag tags what its
/// `holds.0` references.
aspect holds.0: set<ref>;

// ---- Tags ----

/// Marks a thing as a tag users see.
aspect tag.0: struct {
    /// `#rrggbb`.
    color 0: option<string>,
};

// ---- Rights ----
// Who may read, write or administer a thing. Rights are granted to actors (people, devices,
// organizations) and pass along chains of grants (spec/permissions.md).

/// Each role includes the ones below it: sync < read < write < admin. Sync holds and serves the
/// thing's data without reading it.
type role = enum {
    read 0,
    write 1,
    admin 2,
    sync 3,
};

/// Where a write came from (spec/crdt.md §2.1): a 32-byte commit ID, or a 31-byte session ID.
type source = enum {
    commit 0 (blob),
    session 1 (blob),
};

/// One grant of rights to one holder (spec/permissions.md §2).
type edge = struct {
    role 0: role,
    /// When the grant ends; absent: never.
    until 1: option<timestamp>,
    /// The holder may add new holders, up to this grant's role (spec/permissions.md §2).
    may_grant 2: bool,
    /// With `until`: when it passes, the holder's nodes keep a read-only copy (spec/permissions.md
    /// §3, Retain).
    retain 3: bool,
    /// Granted without earlier history: the holder reads from this change of secrets on
    /// (spec/crypto.md §4).
    floor 4: option<int>,
};

/// Who holds which rights on the thing, by holder.
aspect roles.0: map<weak, edge>;

/// Which keys sign as the thing, with what grant (spec/permissions.md §1 Key grant): by key, its
/// grant as `roles.0`'s (role, `until`, `may_grant`; never `retain` or `floor`).
aspect signers.0: map<signing_key, edge>;

/// A set of 32-byte commit IDs.
type frontier = struct {
    commits 0: set<blob>,
};

/// Answers to removals of someone's rights: by the removal's commit ID, the commits the writer
/// of the answer vouches for (spec/permissions.md §5.2).
aspect addenda.0: map<blob, frontier>;

// ---- Keys ----
// Everything shared is encrypted. Each actor has a secret per role; whoever holds the read
// secret can read what the actor shares, whoever holds the sync secret can hold and serve it. Changing who holds a role means making new secrets
// (a new epoch) and giving them to the remaining holders (spec/crypto.md).

/// A public encryption key. x25519_mlkem768: the X25519 then the ML-KEM-768 public key, 1216 bytes.
type kem_key = enum {
    x25519_mlkem768 1 (blob),
};

/// Data encrypted to a `kem_key` (spec/wire.md §3).
type sealed = enum {
    x25519_mlkem768 1 (blob),
};

/// One generation of an actor's secrets. `nonce`: 32 bytes.
type epoch = struct {
    n 0: int,
    nonce 1: blob,
};

/// The public keys of one role's secret at one epoch (spec/crypto.md §4).
type keyset = struct {
    epoch 0: epoch,
    kem_key 1: kem_key,
    /// Which set of algorithms the secret is used with.
    suite 2: int,
    /// The earlier epochs this one replaces.
    supersedes 3: set<epoch>,
    /// 32-byte digest of the names this change of secrets records.
    names 4: blob,
    /// Per holder actor this change of secrets left out of the role, the keysets of it it was
    /// left out at, each with the 32-byte IDs of its causes' commits: it stays left out at a
    /// keyset while a cause stands (spec/crypto.md §4, Left out).
    left_out 5: map<weak, map<epoch, set<blob>>>,
    /// 32-byte IDs of other commits demoting a writer or admin of the actor or of an actor
    /// below it, which travel with the keyset (spec/crypto.md §4, Carried demotions).
    demotions 6: set<blob>,
    /// Whether this keyset's own commit is such a demotion.
    demotes 7: bool,
};

/// The delete and write keys of a step of an actor's sync ID (spec/sync-ids.md §2).
type step_keys = struct {
    delete 0: signing_key,
    write 1: signing_key,
};

/// An actor's public keys (spec/crypto.md §3).
aspect keys.0: struct {
    /// One per role.
    read 0: option<keyset>,
    write 1: option<keyset>,
    admin 2: option<keyset>,
    /// The thing's inbox, where it is another thing (spec/sync-inbox.md §1).
    inbox 4: option<weak>,
    /// 32 bytes. Lets others add data for the actor at nodes keeping it unread without being able to read it
    /// (spec/sync-ids.md §2).
    deposit_seed 5: option<blob>,
    sync 7: option<keyset>,
    /// Per box of the actor's secrets to a holder actor, keyed as that box, the keysets of the
    /// holder it names: written with the box, whoever boxes (spec/crypto.md §4, Stale).
    sealed 8: map<box_key, set<epoch>> = {},
    /// 16 bytes. Its sync ID (spec/sync-ids.md §2), where external fires on it go.
    sync_id 9: option<blob>,
    /// The keys of the step its `sync.0` records in the same write: what a writer holding no
    /// `sync.0` of the actor lists, a fire from outside among them (spec/crypto.md §7 Header
    /// list). Written by an admin, with the step.
    step 10: option<step_keys>,
};

type box_key = struct {
    holder 0: weak,
    role 1: role,
    epoch 2: epoch,
};

/// A role's secret, encrypted for one holder (spec/wire.md §7): to the holder's public key, or
/// under a secret the holder already has, or to several of the holder's keysets at once (opening
/// only for a holder of each).
type box = enum {
    sealed 0 (struct {
        keyset 0: option<epoch>,
        suite 1: int,
        box 2: sealed,
    }),
    symmetric 1 (struct {
        epoch 0: epoch,
        wrap 1: blob,
    }),
    joint 2 (struct {
        keysets 0: set<epoch>,
        suite 1: int,
        box 2: sealed,
    }),
};

type history_key = struct {
    role 0: role,
    epoch 1: epoch,
};

/// An actor's secrets, encrypted for each holder (spec/crypto.md §4). `history`: each epoch's
/// box of the earlier secrets, so a new holder can read what was shared before.
aspect secrets.0: struct {
    boxes 0: map<box_key, box>,
    history 1: map<history_key, blob>,
};

// ---- Syncing ----
// An independent thing syncs under its home sync ID: nodes keeping it unread hold
// encrypted data they cannot read, and its steps prove who may fetch and add to it
// (spec/sync-ids.md §2).

/// One step: tells nodes keeping the sync ID unread which keys may use it from now on (spec/wire.md §8).
type step_record = struct {
    step 0: blob,
    /// The readers it lets in.
    claims 1: option<blob>,
    /// Endorsements of this step by other steps' delete keys, by delete key: a node keeping the
    /// sync ID unread on such a step may move here (spec/sync-ids.md §6 Register).
    endorsements 2: map<blob, blob>,
};

type sync_entry = struct {
    /// Steps, by step ID.
    steps 0: map<blob, step_record>,
};

/// A thing's sync IDs, by 16-byte sync ID (spec/sync-ids.md §4).
aspect sync.0: map<blob, sync_entry>;

/// The thing's dial list: each node's 32-byte dialable key to the URLs it is dialed at
/// (spec/sync-set.md §1), each node keeping its own entry. Its readers dial them, for dialing only.
aspect dial.0: map<blob, list<string>>;

// ---- Devices ----
// Each device running osis (a node) is itself a thing, with these aspects about it.

/// Limits on what the device stores of one thing it keeps unread.
type thing_caps = struct {
    entries 0: int,
    bytes 1: int,
};

/// Limits on what peers may make the device store of the sync IDs it keeps unread
/// (spec/sync-ids.md §5); absent: the defaults.
admin aspect caps^.0: struct {
    /// Tuning settings by name.
    policy 0: map<string, int>,
    /// Per-thing limits, applied to each sync ID the thing owns.
    things 1: map<weak, thing_caps>,
};

/// A thin client: an app that uses this device's data from elsewhere instead of keeping its own.
type client = struct {
    /// BLAKE3 of the client's 32-byte secret.
    secret_hash 0: blob,
    /// When its access ends; absent: never.
    until 1: option<timestamp>,
};

/// The thin clients this node serves, by the client's actor (on the node root).
admin aspect clients^.0: map<weak, client>;

// ---- Retention ----
// What a thing keeps of replaced content, set by its admins per aspect (spec/commits.md §5).

/// How long replaced values stay readable as history: until a time (2^63 - 1: forever) and/or
/// for a duration after being replaced.
type keep = struct {
    until 0: option<timestamp>,
    after 1: option<duration>,
};

type history = enum {
    keep 0 (keep),
    purge_on_replace 1,
};

/// What a thing promises for replaced content of an aspect (absent: none promised), the expiry
/// a writer gives its writes there, whether a writer refuses to replace a fire (`final`), and
/// before when written content is purged on replace whatever `history` says (`purge_before`: a
/// commit `ts`, spec/crdt.md §2.2; set by the writer replacing a purge-on-replace entry, carried
/// by every later one).
type retention_entry = struct {
    history 0: option<history>,
    expires 1: option<duration>,
    final 2: bool,
    purge_before 3: option<int>,
};

type retention_setting = struct {
    /// By AK.
    rules 0: map<string, retention_entry>,
    /// Whether someone whose access is removed may keep a copy, by default (spec/permissions.md §3).
    retain 1: bool,
    /// For every AK not in `rules`.
    default 2: option<retention_entry>,
    /// A strong in a held body of this thing's history holds its target, as a current one does
    /// (spec/data-model.md §8 What counts).
    history_holds_targets 3: bool,
};

/// What this thing keeps of replaced content.
admin aspect retention^.0: retention_setting;

/// Written by a request to purge by name or by author; the time is all it says.
aspect purge.0: timestamp;

