//! Core schema: the aspects every osis node understands. Apps mostly use the "Content" and
//! "Groups" sections and the read-only identity aspects; the rest are records osis itself keeps
//! (who may do what, keys, syncing, devices), whose exact rules are in the spec section named.
revision 1;

// ---- Identity ----
// What every thing has from the start: its tid, which aspects it has, and how it was created.

/// The thing's own tid.
synthetic guaranteed aspect tid.0: tid;

/// The AKs present on the thing.
synthetic guaranteed aspect aspects.0: set<string>;

/// A public signing key. ed25519: 32 bytes.
type signing_key = enum {
    ed25519 1 (blob),
};

/// How a thing was created (spec/wire.md §3). Exactly one of `admin` and `key` is set:
/// - `admin`: the thing's first admin, who made it;
/// - `key`: the thing is a key actor, a device, recovery key or share-link key identified by
///   this public key. It has no admin; whoever holds the key's secret acts as it.
/// `link`, only ever set to true and only beside `admin`: the thing is a share link's actor.
type creation = struct {
    admin 0: tid,
    key 1: signing_key,
    nonce 2: blob,
    link 3: bool,
};

guaranteed purgeable_by(nobody) keep_history(forever) aspect created.0: creation;

// ---- Content ----
// General-purpose aspects any app can use, so that apps agree on what to call and show a thing.

/// What humans call the thing.
keep_history(1d) aspect name.0: string;

/// Freeform content: a note's text, or notes on anything else.
keep_history(1d) aspect body.0: markdown;

// ---- Groups ----
// Things are organized, shared and synced as groups: a group lists its items and subgroups, and
// syncing a group syncs everything it reaches. Tags are the groups users see.

/// Makes the thing a group.
keep_history(1d) aspect group.0: struct {
    items 0: set<tid> = [],
    subgroups 1: set<tid> = [],
};

/// The groups this device knows that hold the thing, directly or through subgroups.
synthetic guaranteed aspect groups.0: set<tid>;

/// Marks a group as a tag users see: its items are what is tagged, its subgroups are sub-tags.
/// Groups without it are internal and never shown.
keep_history(1d) aspect tag.0: struct {
    /// `#rrggbb`.
    color 0: option<string>,
};

// ---- Rights ----
// Who may read, write or administer a thing. Rights are granted to actors (people, devices,
// groups) and pass along chains of grants (spec/permissions.md).

/// Each role includes the ones below it.
type role = enum {
    read 0,
    write 1,
    admin 2,
};

/// Where a write came from (spec/crdt.md §2.1): a 32-byte commit ID, or a 31-byte session ID.
type source = enum {
    commit 0 (blob),
    session 1 (blob),
};

/// Names one membership in a `group.0`: when it was added, and whether as a subgroup.
type tie = struct {
    ts 0: int,
    source 1: source,
    ctr 2: int,
    subgroup 3: bool,
};

/// One grant of rights to one holder (spec/permissions.md §2).
type edge = struct {
    role 0: role,
    /// When the grant ends; absent: never.
    until 1: option<timestamp>,
    /// The highest role the holder may grant to others.
    invite 2: option<role>,
    /// The membership this grant goes with: taking the thing out of that group removes the grant.
    tied 3: option<tie>,
};

/// Who holds which rights on the thing, by holder.
purgeable_by(admin) aspect roles.0: map<tid, edge>;

/// A set of 32-byte commit IDs.
type frontier = struct {
    commits 0: set<blob>,
};

/// Answers to removals of someone's rights: by the removal's commit ID, the commits the writer
/// of the answer vouches for (spec/permissions.md §5.2).
purgeable_by(admin) aspect addenda.0: map<blob, frontier>;

// ---- Keys ----
// Everything shared is encrypted. Each actor has a secret per role; whoever holds the read
// secret can read what the actor shares. Changing who holds a role means making new secrets
// (a new epoch) and giving them to the remaining holders (spec/crypto.md).

/// ed25519: 64 bytes.
type signature = enum {
    ed25519 1 (blob),
};

/// A public encryption key. x25519_mlkem768: the X25519 then the ML-KEM-768 public key, 1216 bytes.
type kem_key = enum {
    x25519_mlkem768 1 (blob),
};

/// Data encrypted to a `kem_key` (spec/wire.md §3).
type sealed = enum {
    x25519_mlkem768 1 (blob),
};

/// One generation of an actor's secrets. `nonce`: 32 bytes.
type epoch = struct {
    n 0: int,
    nonce 1: blob,
};

/// A host: where to connect (a URL) and its 32-byte public key.
type address = struct {
    url 0: string,
    key 1: blob,
};

/// The public keys of one role's secret at one epoch (spec/crypto.md §4).
type keyset = struct {
    epoch 0: epoch,
    kem_key 1: kem_key,
    /// Which set of algorithms the secret is used with.
    suite 2: int,
    /// Lets holders of the secret delete stored data at hosts (spec/crypto.md §7).
    delete_key 3: signing_key,
    /// The earlier epochs this one replaces.
    supersedes 4: set<epoch>,
    /// Lets a holder prove it has the secret.
    possession_key 5: signing_key,
    /// 32-byte digest of the names this change of secrets records.
    names 6: blob,
    /// Per holder actor the rotator holds the role through, that it holds a secret of it
    /// (spec/crypto.md §4).
    proofs 7: map<tid, possession_proof>,
};

/// A signature over a keyset by the possession key of a holder actor's keyset (spec/wire.md §7).
type possession_proof = struct {
    keyset 0: epoch,
    signature 1: signature,
};

/// Where others can drop things for an actor: a 16-byte label ID and the hosts holding it.
type inbox = struct {
    label 0: blob,
    hosts 1: list<address>,
};

/// An actor's public keys (spec/crypto.md §3).
purgeable_by(admin) aspect keys.0: struct {
    /// One per role. Absent for a key actor.
    read 0: option<keyset>,
    write 1: option<keyset>,
    admin 2: option<keyset>,
    /// A key actor's one encryption key.
    key 3: option<kem_key>,
    inbox 4: option<inbox>,
    /// 32 bytes. Lets others add data for the actor at hosts without being able to read it
    /// (spec/sync.md §2).
    deposit_seed 5: option<blob>,
};

type box_key = struct {
    holder 0: tid,
    role 1: role,
    epoch 2: epoch,
};

/// A role's secret, encrypted for one holder (spec/wire.md §7): to the holder's public key, or
/// under a secret the holder already has.
type box = enum {
    sealed 0 (struct {
        keyset 0: option<epoch>,
        suite 1: int,
        box 2: sealed,
    }),
    symmetric 1 (struct {
        epoch 0: epoch,
        wrap 1: blob,
        possession 2: option<signature>,
    }),
};

type history_key = struct {
    role 0: role,
    epoch 1: epoch,
};

/// An actor's secrets, encrypted for each holder (spec/crypto.md §4). `history`: each epoch's
/// box of the earlier secrets, so a new holder can read what was shared before.
purgeable_by(admin) aspect secrets.0: struct {
    boxes 0: map<box_key, box>,
    history 1: map<history_key, blob>,
};

// ---- Syncing ----
// A synced group is stored at hosts under a label: hosts hold encrypted data they cannot read,
// and the label proves who may fetch and add to it (spec/sync.md §2).

/// One registration step: tells hosts which keys may use the label from now on (spec/wire.md §8).
type step_record = struct {
    step 0: blob,
    /// The readers it lets in.
    claims 1: option<blob>,
};

type label = struct {
    /// 0 for the group's first label; a replacement takes the next.
    index 0: int,
    /// Registration steps, by step ID.
    steps 1: map<blob, step_record>,
    hosts 2: list<address>,
    /// A newer label took over; nobody syncs this one.
    replaced 3: bool,
};

/// A synced group's labels, by 16-byte label ID.
purgeable_by(admin) aspect label.0: map<blob, label>;

// ---- Devices ----
// Each device running osis (a node) is itself a thing, with these aspects about it.

/// The device's software version.
aspect node.0: struct {
    software 0: string,
};

/// How to reach the device directly (spec/sync.md §10): its 32-byte public key, its `peer://`
/// addresses and relays, and a 32-byte secret for finding it on the local network.
aspect reach.0: struct {
    dialable 0: blob,
    items 1: list<string>,
    lan_secret 2: blob,
};

/// An aspect a device reports as damaged, with a 16-byte digest of its state.
type suspect = struct {
    thing 0: tid,
    ak 1: string,
    digest 2: blob,
};

/// The device's last sync of a group (spec/permissions.md §4). `stranded`: it cannot read the
/// group's current secrets; `suspect`: damaged aspects it asks others to repair.
aspect seen.0: struct {
    ts 0: timestamp,
    stranded 1: bool,
    suspect 2: set<suspect>,
};

/// Which labels a host takes: its own account's groups, or anyone's.
type admit = enum {
    own 0,
    open 1,
};

/// Limits on what a host stores for one label.
type host_caps = struct {
    entries 0: int,
    bytes 1: int,
};

/// The device acts as a host, storing others' synced groups (spec/sync.md §4); absent: it does not.
admin aspect host^.0: struct {
    /// Addresses to listen on.
    listen 0: list<string>,
    admit 1: admit,
    /// Label IDs (16 bytes) taken beyond what `admit` allows.
    labels 2: set<blob>,
    /// Other hosts to copy to.
    replicate 3: list<address>,
    /// Tuning settings by name.
    policy 4: map<string, int>,
    /// Per-label limits, by label ID.
    caps 5: map<blob, host_caps>,
};

/// A thin client: an app that uses this device's data from elsewhere instead of keeping its own.
type client = struct {
    /// BLAKE3 of the client's 32-byte secret.
    secret_hash 0: blob,
    /// When its access ends; absent: never.
    until 1: option<timestamp>,
};

/// The thin clients this device serves, by the client's actor.
admin aspect clients^.0: map<tid, client>;

// ---- Retention ----
// How long old values stay readable, and who may delete them. Each write says this for itself;
// a thing can require what its writes must say (spec/commits.md §5).

/// How long replaced values stay readable as history: until a time (2^63 - 1: forever) and/or
/// for a duration after being replaced.
type keep = struct {
    until 0: option<timestamp>,
    after 1: option<duration>,
};

type history = enum {
    keep 0 (keep),
    purge_on_replace 1,
};

/// A retention every write of an aspect must carry: who may purge it, its history (absent: none
/// promised) and when it expires.
type required = struct {
    by 0: enum {
        nobody 0,
        admin 1,
        author_or_admin 2,
        writer 3,
        author 4,
    },
    history 1: option<history>,
    expires 2: option<duration>,
};

type required_rules = struct {
    /// By AK.
    rules 0: map<string, required>,
    /// Whether someone whose access is removed may keep a copy, by default (spec/permissions.md §3).
    retain 1: bool,
    /// For every AK not in `rules`.
    default 2: option<required>,
};

/// The retention writes to this thing must carry.
admin aspect required^.0: required_rules;

/// Written by a request to purge by name or by author; the time is all it says.
aspect purge.0: timestamp;
