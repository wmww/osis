//! What is specific to the first-party osis app, beyond the kit's view system (schema/ui.osis). Notes
//! and tags use core aspects, events and people use event.osis and contact.osis, and messages
//! chat.osis; only the app's own bits are here.
revision 1;

// ---- The account group ----
// The app keeps one internal group per account (kit's "account group"; see schema/ui.osis): an item
// and subgroup of the account's home, so it syncs and its items sync. Nodes that started before
// syncing each make one; all are read and writes go to the smallest tid.

/// Marks the app's account group among home's subgroups: an app finds its own group by this scan,
/// because a tid depends on who made it first.
aspect osis_app:app.0: bool;

/// On the account group: this account already received the demo data (`--demo`), so a second device
/// or run adds none.
aspect osis_app:demo.0: bool;

// ---- Appearance ----

/// A thing's colour (`#rrggbb`) when nothing better gives it one (a tag's colour is in `tag.0`).
/// Written by the app's seeds and demo data, read as the summary's colour fallback.
aspect osis_app:color.0: string;

// ---- Node state of the app's own facets ----
// As in schema/ui.osis: on a window, a map keyed by node path.

/// A composer's fields being written, by field entry (`<node path>#subject`, `#text`). Durable: a
/// half-written message survives a restart. Edited through a text session on the entry; cleared when
/// sent.
aspect osis_app:draft.0: map<string, string>;

/// The message a composer answers, as its id. Durable, like the draft it goes with.
aspect osis_app:reply_to.0: map<string, string>;
