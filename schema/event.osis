//! Calendar events. Name: `name.0`; notes: `body.0`; a calendar is a tag of events (its colour in
//! `tag.0`). Times are wall-clock times with a time zone; days are calendar dates with no zone.
revision 1;

/// A wall-clock time in an IANA time zone (or a fixed `+HH:MM` offset). No zone: floating, shown
/// in whatever zone the viewer is in.
type wall = struct {
    time 0: localtime,
    zone 1: option<string>,
};

type weekday = enum {
    mon 0,
    tue 1,
    wed 2,
    thu 3,
    fri 4,
    sat 5,
    sun 6,
};

/// One occurrence of a repeating event, named by the start the repeat rule gives it (before any
/// change to that occurrence).
type occurrence = enum {
    at 0 (localtime),
    day 1 (date),
};

/// When the event starts: a time, or a whole day. Absent: not scheduled yet.
aspect event:start.0: enum {
    at 0 (wall),
    day 1 (date),
};

/// When it ends: a time (in its own zone, which may differ from the start's), the last day
/// (inclusive), or a duration after the start. Absent: a moment, or one day. Must be the same
/// kind as the start (time or day) and not before it.
aspect event:end.0: enum {
    at 0 (wall),
    day 1 (date),
    after 2 (duration),
};

aspect event:location.0: string;

/// How the event repeats.
aspect event:repeat.0: struct {
    freq 0: enum {
        daily 0,
        weekly 1,
        monthly 2,
        yearly 3,
    },
    /// Every this many days, weeks, months or years.
    interval 1: int = 1,
    /// Weekly: on these days. Monthly and yearly: the nth such day of the month or year, -1 the last.
    weekdays 2: set<struct {
        day 0: weekday,
        nth 1: option<int>,
    }>,
    /// Days of the month.
    monthdays 3: set<int>,
    /// The last day it may occur.
    until 4: option<date>,
    /// How many times it occurs.
    count 5: option<int>,
    /// Occurrences removed from the series.
    skip 6: set<occurrence>,
};

/// This event replaces one occurrence of a repeating event (that occurrence, changed).
aspect event:overrides.0: struct {
    series 0: tid,
    at 1: occurrence,
};

/// Reminders, this long before the start.
aspect event:alerts.0: set<duration>;
