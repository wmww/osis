//! The schema of schemas: every parsed `.osis` file is a value of type `schema`
//! (spec/data-model.md §10).
revision 1;

// ---- The schema ----

type schema = struct {
    /// Bumped on every publish.
    revision 0: int,
    /// By type name.
    types 1: map<string, type_def>,
    /// By AK.
    aspects 2: map<string, aspect_def>,
    doc 3: option<string>,
};

// ---- Types ----

/// A named type; `params` for a generic one (`tagged<T>`).
type type_def = struct {
    params 0: list<string>,
    body 1: type_expr,
    doc 2: option<string>,
};

type type_expr = enum {
    string 0,
    blob 1,
    bool 2,
    int 3,
    float 4,
    tid 5,
    any 6,
    text 7,
    list 8 (type_expr),
    set 9 (type_expr),
    map 10 (struct {
        key 0: type_expr,
        value 1: type_expr,
    }),
    struct 11 (struct {
        fields 0: map<int, field_def>,
        /// IDs never to be used again.
        reserved 1: set<int>,
    }),
    enum 12 (struct {
        cases 0: map<int, case_def>,
        /// IDs never to be used again.
        reserved 1: set<int>,
    }),
    counter 13 (type_expr),
    max 14 (type_expr),
    min 15 (type_expr),
    /// A type declared in the schema, or a standard one (`option`, `markdown`, `timestamp`, ...).
    named 16 (struct {
        name 0: string,
        args 1: list<type_expr>,
    }),
    /// A parameter of the enclosing `type_def`.
    param 17 (string),
};

type field_def = struct {
    name 0: string,
    type 1: type_expr,
    default 2: option<any>,
    /// The fields this one replaces.
    succeeds 3: set<int>,
    doc 4: option<string>,
};

type case_def = struct {
    name 0: string,
    payload 1: option<type_expr>,
    /// The cases this one replaces.
    succeeds 2: set<int>,
    doc 3: option<string>,
};

// ---- Aspects ----

/// Who may purge the aspect's values (what history keeps is the thing's setting, `retention^.0`).
type retention = struct {
    by 0: enum {
        admin 1,
        author_or_admin 2,
        writer 3,
    },
};

type flag = enum {
    /// Computed by each device, never written.
    synthetic 0,
    /// Present on every thing.
    guaranteed 1,
};

type aspect_def = struct {
    type 0: type_expr,
    /// The default retention of writes.
    retention 1: retention,
    /// Default expiry, after the write.
    expires 2: option<duration>,
    flags 3: set<flag>,
    /// The AKs this one replaces.
    succeeds 4: set<string>,
    doc 5: option<string>,
};
